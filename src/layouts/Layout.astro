---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Your guide to options trading" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>

  <!-- Open Graph / Social sharing -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="Rose.Trading" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content="https://rose.trading/rose-banner.png" />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url"         content="https://rose.trading" />

  <!-- Twitter / X card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content="https://rose.trading/rose-banner.png" />

  <link rel="manifest" href="/manifest.json" />
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/rose-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
  <slot name="head" />
  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>

<script is:inline>
  // Only initialize OneSignal on the members alerts page
  if (window.location.pathname.startsWith('/alerts-members-x9q3')) {
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    window.OneSignalDeferred.push(async function(OneSignal) {
      await OneSignal.init({
        appId: "48b95503-4b11-4a91-9806-059e84277551",
        allowLocalhostAsSecureOrigin: true,
      });
    });
  }
</script>
</head>
<body>
  <header>
    <nav class="container">
      <div class="nav-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo">
          <img src="/rose-logo.png" alt="Rose Trading Logo" style="width: 60px; height: 60px; object-fit: contain;" />
        </a>

        <!-- Hamburger button -->
        <button
          class="ham-btn"
          id="ham-btn"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="nav-menu"
          onclick="toggleNav(this)"
        >
          <span class="ham-line ham-top"></span>
          <span class="ham-line ham-mid"></span>
          <span class="ham-line ham-bot"></span>
        </button>
      </div>
    </nav>

    <!-- Full-screen dropdown menu -->
    <div class="nav-menu" id="nav-menu" role="dialog" aria-label="Navigation menu">
      <nav class="nav-menu-inner">
        <a href="/" class="nav-menu-link" onclick="closeNav()">Home</a>
        <a href="/about" class="nav-menu-link" onclick="closeNav()">About</a>
        <a href="/morning-brief" class="nav-menu-link" onclick="closeNav()">News</a>
        <a href="/course" class="nav-menu-link" onclick="closeNav()">Course</a>
        <a href="/guides" class="nav-menu-link" onclick="closeNav()">Guides</a>
        <a href="/resources" class="nav-menu-link" onclick="closeNav()">Resources</a>
        <a href="/alerts" class="nav-menu-link" onclick="closeNav()">Alerts</a>
        <a href="/contact" class="nav-menu-link" onclick="closeNav()">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer style="background: var(--bg-secondary); padding: 3rem 0; margin-top: 4rem;">
    <div class="container">
      <p style="text-align: center; color: var(--text-secondary);">
        © 2026 Rose.Trading. Start your journey.
      </p>
    </div>
  </footer>
</body>
</html>

<style>
  /* ── Nav bar ── */
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: var(--bg-primary);
    border-bottom: 1px solid rgba(153, 139, 255, 0.1);
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    z-index: 300;
    position: relative;
  }

  /* ── Hamburger button ── */
  .ham-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 300;
    position: relative;
  }

  .ham-line {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--accent-primary);
    border-radius: 2px;
    transform-origin: center;
    transition: transform 0.28s ease, opacity 0.2s ease, background 0.2s;
  }

  .ham-btn:hover .ham-line {
    background: var(--accent-secondary, #5F5CFF);
  }

  /* X state — toggled via .nav-open on <header> */
  header.nav-open .ham-top {
    transform: translateY(8px) rotate(45deg);
  }
  header.nav-open .ham-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  header.nav-open .ham-bot {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* ── Full-screen dropdown ── */
  .nav-menu {
    position: fixed;
    inset: 0;
    background: var(--bg-primary);
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;

    /* hidden state */
    opacity: 0;
    pointer-events: none;
    transform: translateY(-12px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  header.nav-open ~ .nav-menu,   /* sibling approach fallback */
  .nav-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav-menu-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 6rem 2rem 4rem;
  }

  .nav-menu-link {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.5rem 1.5rem;
    border-radius: 10px;
    letter-spacing: 0.02em;
    transition: color 0.15s, background 0.15s;
    width: 100%;
    max-width: 340px;
    text-align: center;
  }

  .nav-menu-link:hover {
    color: var(--accent-primary);
    background: rgba(153, 139, 255, 0.08);
  }
</style>

<script is:inline>
  function toggleNav(btn) {
    const header = btn.closest('header');
    const menu   = document.getElementById('nav-menu');
    const isOpen = header.classList.toggle('nav-open');
    menu.classList.toggle('open', isOpen);
    btn.setAttribute('aria-expanded', isOpen);
    // Prevent body scroll while menu is open
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  function closeNav() {
    const header = document.querySelector('header');
    const menu   = document.getElementById('nav-menu');
    const btn    = document.getElementById('ham-btn');
    header.classList.remove('nav-open');
    menu.classList.remove('open');
    if (btn) btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  // Close on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeNav();
  });
</script>
