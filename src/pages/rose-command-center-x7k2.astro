---
// rose-command-center-x7k2.astro — private command center
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Command Center</title>
  <style>
    :root {
      --bg:       #0B0C15;
      --card:     #1C1E2D;
      --purple:   #998BFF;
      --blue:     #5F5CFF;
      --text:     #E0E0E0;
      --muted:    #666;
      --green:    #3DDC84;
      --red:      #FF5C5C;
      --border:   #2a2d3e;
      --input-bg: #0e0f1a;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      padding: 1.25rem 1rem 3rem;
    }

    h1 {
      text-align: center;
      color: var(--purple);
      font-size: .95rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      opacity: .6;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      max-width: 980px;
      margin: 0 auto;
    }
    @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } }

    /* ── Panel ─────────────────────────────────────────────── */
    .panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem;
    }

    .panel-title {
      display: flex;
      align-items: center;
      gap: .5rem;
      color: var(--purple);
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
      margin-bottom: 1.1rem;
      padding-bottom: .8rem;
      border-bottom: 1px solid var(--border);
    }

    /* ── Field labels ──────────────────────────────────────── */
    .field-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: .9rem;
      margin-bottom: .35rem;
    }
    .field-label span {
      font-size: .68rem;
      color: var(--muted);
      letter-spacing: .09em;
      text-transform: uppercase;
    }
    .field-label .opt {
      font-size: .62rem;
      color: #3a3a55;
      font-style: italic;
      text-transform: none;
      letter-spacing: 0;
    }

    /* ── Inputs ────────────────────────────────────────────── */
    textarea,
    input[type="text"],
    input[type="url"],
    input[type="number"],
    input[type="date"] {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: .84rem;
      padding: .6rem .75rem;
      outline: none;
      transition: border-color .2s;
      font-family: inherit;
      -webkit-appearance: none;
      appearance: none;
    }
    textarea { resize: vertical; min-height: 80px; }

    textarea:focus,
    input:focus { border-color: var(--blue); }

    input[type="date"]::-webkit-calendar-picker-indicator {
      filter: invert(0.5);
      cursor: pointer;
    }

    .url-field { font-family: 'SF Mono', 'Fira Code', monospace; font-size: .76rem; }

    .url-warn {
      font-size: .66rem;
      color: #e0a030;
      margin-top: .22rem;
      display: none;
    }
    .url-warn.visible { display: block; }

    /* ── 3-col input row ───────────────────────────────────── */
    .input-row {
      display: grid;
      grid-template-columns: 1fr 1.2fr 1fr;
      gap: .5rem;
      margin-top: .9rem;
    }
    .input-col { display: flex; flex-direction: column; gap: .3rem; }
    .input-col .field-label { margin-top: 0; }

    /* ── Chips ─────────────────────────────────────────────── */
    .chip-row { display: flex; gap: .45rem; flex-wrap: wrap; }

    .chip {
      padding: .32rem .7rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--muted);
      font-size: .73rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .15s;
      white-space: nowrap;
    }
    .chip:hover { border-color: var(--blue); color: var(--text); }
    .chip-green.active  { background: var(--green);  border-color: var(--green);  color: #000; }
    .chip-red.active    { background: var(--red);    border-color: var(--red);    color: #fff; }
    .chip-blue.active   { background: var(--green);  border-color: var(--green);  color: #000; }
    .chip-purple.active { background: var(--purple); border-color: var(--purple); color: #000; }

    /* ── Buttons ───────────────────────────────────────────── */
    .btn {
      width: 100%;
      margin-top: .9rem;
      padding: .72rem;
      border-radius: 10px;
      border: none;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .4rem;
      transition: opacity .15s, transform .1s;
    }
    .btn:hover   { opacity: .88; }
    .btn:active  { transform: scale(.98); }
    .btn:disabled { opacity: .35; cursor: not-allowed; }
    .btn-primary   { background: var(--blue);   color: #fff; }
    .btn-secondary { background: var(--purple); color: #000; }
    .btn-ghost     { background: #1e2030; color: var(--text); border: 1px solid var(--border); }

    /* ── Divider ────────────────────────────────────────────── */
    .divider {
      display: flex; align-items: center; gap: .5rem; margin: 1.1rem 0;
    }
    .divider span { font-size: .62rem; color: #333; text-transform: uppercase; letter-spacing: .1em; white-space: nowrap; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── Live preview card (SPX alert) ─────────────────────── */
    .live-preview {
      margin-top: .9rem;
      border-radius: 0 8px 8px 0;
      border-left: 4px solid var(--border);
      background: #1e1f2e;
      padding: .75rem .9rem;
      transition: border-color .2s;
    }
    .live-preview.green { border-left-color: var(--green); }
    .live-preview.red   { border-left-color: var(--red); }

    .lp-label {
      font-size: .6rem;
      color: #444;
      text-transform: uppercase;
      letter-spacing: .1em;
      margin-bottom: .4rem;
    }
    .lp-title {
      font-size: .8rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: .3rem;
    }
    .lp-body {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: .76rem;
      color: #b0bac9;
      background: #13141f;
      border-radius: 4px;
      padding: .45rem .6rem;
      white-space: pre-wrap;
      word-break: break-word;
      min-height: 2rem;
    }
    .lp-body.empty { color: #333; font-style: italic; }
    .lp-footer {
      font-size: .62rem;
      color: #3a3c50;
      margin-top: .3rem;
    }

    /* ── Status ────────────────────────────────────────────── */
    .status {
      font-size: .74rem;
      margin-top: .45rem;
      min-height: 1rem;
      text-align: center;
      border-radius: 6px;
      padding: .25rem .5rem;
    }
    .status.success { color: var(--green); }
    .status.error   { color: var(--red); }
    .status.warn    { color: #e0a030; }
  </style>
</head>
<body>

<h1>Command Center</h1>

<div class="grid">

  <!-- ── LEFT: SPX ALERT ───────────────────────────────────── -->
  <div class="panel">
    <div class="panel-title">⚡ SPX Alert</div>

    <div class="field-label" style="margin-top:0"><span>Direction</span></div>
    <div class="chip-row" id="direction-chips">
      <button class="chip chip-green" data-val="CALL">📈 CALL</button>
      <button class="chip chip-red"   data-val="PUT">📉 PUT</button>
    </div>

    <div class="field-label"><span>Action</span></div>
    <div class="chip-row" id="action-chips">
      <button class="chip chip-blue"   data-val="🚀 ENTRY">🚀 ENTRY</button>
      <button class="chip chip-blue"   data-val="✅ EXIT">✅ EXIT</button>
      <button class="chip chip-red"    data-val="🛑 STOP HIT">🛑 STOP HIT</button>
      <button class="chip chip-purple" data-val="👀 WATCHING">👀 WATCHING</button>
    </div>

    <div class="input-row">
      <div class="input-col">
        <div class="field-label"><span>Strike</span></div>
        <input type="number" id="alert-strike" placeholder="5400" />
      </div>
      <div class="input-col">
        <div class="field-label"><span>Expiry</span></div>
        <input type="date" id="alert-expiry" />
      </div>
      <div class="input-col">
        <div class="field-label"><span>Price Paid</span></div>
        <input type="number" id="alert-price" step="0.01" placeholder="2.50" />
      </div>
    </div>

    <div class="field-label"><span>Notes</span><span class="opt">optional</span></div>
    <input type="text" id="alert-notes" placeholder="e.g. tight stop at 5380, targeting 5450..." />

    <div class="field-label"><span>Chart URL</span><span class="opt">optional</span></div>
    <input type="url" id="alert-image-url" class="url-field" placeholder="https://...image.png" />
    <div class="url-warn" id="alert-url-warn">⚠️ Must end in .png / .jpg / .gif</div>

    <!-- Live preview -->
    <div class="live-preview" id="live-preview">
      <div class="lp-label">Preview</div>
      <div class="lp-title" id="lp-title">⚡ SPX Alert</div>
      <div class="lp-body empty" id="lp-body">Select direction + action to preview...</div>
      <div class="lp-footer" id="lp-footer"></div>
    </div>

    <button class="btn btn-primary" id="alert-btn">✈️ Send Alert</button>
    <div class="status" id="alert-status"></div>
  </div>

  <!-- ── RIGHT: MARKET REVIEW ──────────────────────────────── -->
  <div class="panel">
    <div class="panel-title">📋 Market Review</div>

    <div class="field-label" style="margin-top:0"><span>Adhoc Note</span></div>
    <textarea id="adhoc-input" placeholder="Send a quick note to subscribers e.g. market is choppy, sitting out..."></textarea>

    <div class="field-label"><span>Chart URL</span><span class="opt">optional</span></div>
    <input type="url" id="adhoc-image-url" class="url-field" placeholder="https://...image.png" />
    <div class="url-warn" id="adhoc-url-warn">⚠️ Must end in .png / .jpg / .gif</div>

    <button class="btn btn-ghost" id="adhoc-btn">💬 Send Note</button>
    <div class="status" id="adhoc-status"></div>

    <div class="divider"><span>Market Review</span></div>

    <div class="field-label"><span>Type</span></div>
    <div class="chip-row" id="review-type-chips">
      <button class="chip chip-purple" data-val="Pre-Market Review">🌅 Pre-Market</button>
      <button class="chip chip-purple" data-val="Post-Market Review">🌙 Post-Market</button>
    </div>

    <div class="field-label"><span>Review</span></div>
    <textarea id="review-input" placeholder="Write your pre or post market thoughts here...

What are you watching? Key levels? Bias? How did the day go?" style="min-height:110px;"></textarea>

    <div class="field-label"><span>Chart URL</span><span class="opt">optional</span></div>
    <input type="url" id="review-image-url" class="url-field" placeholder="https://...image.png" />
    <div class="url-warn" id="review-url-warn">⚠️ Must end in .png / .jpg / .gif</div>

    <button class="btn btn-secondary" id="review-btn">✏️ Post Review</button>
    <div class="status" id="review-status"></div>
  </div>

</div>

  <!-- ── SWING ALERT (full-width) ─────────────────────────── -->
  <div class="panel" style="grid-column: 1 / -1;">
    <div class="panel-title">📊 Swing Alert</div>

    <div style="display:grid; grid-template-columns:1fr 2fr; gap:1rem;">

      <!-- Left col: ticker + chart url -->
      <div>
        <div class="field-label" style="margin-top:0"><span>Ticker</span></div>
        <input type="text" id="swing-ticker" placeholder="AAPL, NVDA, SPY..." style="text-transform:uppercase;" />

        <div class="field-label"><span>Chart URL</span><span class="opt">optional</span></div>
        <input type="url" id="swing-image-url" class="url-field" placeholder="https://...image.png" />
        <div class="url-warn" id="swing-url-warn">⚠️ Must end in .png / .jpg / .gif</div>

        <div class="field-label"><span>Notes</span><span class="opt">optional</span></div>
        <input type="text" id="swing-notes" placeholder="e.g. stop below 200 EMA, target $180..." />
      </div>

      <!-- Right col: direction, action, preview -->
      <div>
        <div class="field-label" style="margin-top:0"><span>Direction</span></div>
        <div class="chip-row" id="swing-direction-chips">
          <button class="chip chip-green" data-val="LONG">📈 LONG</button>
          <button class="chip chip-red"   data-val="SHORT">📉 SHORT</button>
        </div>

        <div class="field-label"><span>Action</span></div>
        <div class="chip-row" id="swing-action-chips">
          <button class="chip chip-blue"   data-val="🚀 ENTRY">🚀 ENTRY</button>
          <button class="chip chip-blue"   data-val="✅ EXIT">✅ EXIT</button>
          <button class="chip chip-red"    data-val="🛑 STOP HIT">🛑 STOP HIT</button>
          <button class="chip chip-purple" data-val="👀 WATCHING">👀 WATCHING</button>
        </div>

        <!-- Live preview -->
        <div class="live-preview" id="swing-live-preview" style="margin-top:.9rem;">
          <div class="lp-label">Preview</div>
          <div class="lp-title" id="swing-lp-title">📊 Swing Alert</div>
          <div class="lp-body empty" id="swing-lp-body">Select ticker + direction + action to preview...</div>
          <div class="lp-footer" id="swing-lp-footer"></div>
        </div>

        <button class="btn btn-primary" id="swing-btn" style="background:#3DDC84;color:#000;">📊 Send Swing Alert</button>
        <div class="status" id="swing-status"></div>
      </div>
    </div>
  </div>

</div>

<script is:inline>
  // ── Chip helper ───────────────────────────────────────────
  function makeChips(groupId, onChange) {
    const group = document.getElementById(groupId);
    let selected = null;
    group.querySelectorAll('.chip').forEach(btn => {
      btn.addEventListener('click', () => {
        group.querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
        if (selected !== btn.dataset.val) {
          btn.classList.add('active');
          selected = btn.dataset.val;
        } else {
          selected = null;
        }
        if (onChange) onChange();
      });
    });
    return { get: () => selected };
  }

  // ── Status helper ─────────────────────────────────────────
  function showStatus(id, msg, type) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.className   = 'status ' + type;
    if (type === 'success') setTimeout(() => { el.textContent = ''; el.className = 'status'; }, 3500);
  }

  // ── URL validator ─────────────────────────────────────────
  function isImageUrl(url) {
    return /\.(png|jpg|jpeg|gif|webp)(\?.*)?$/i.test(url);
  }
  ['alert','adhoc','review','swing'].forEach(id => {
    document.getElementById(id + '-image-url').addEventListener('input', function() {
      document.getElementById(id + '-url-warn')
        .classList.toggle('visible', this.value.length > 0 && !isImageUrl(this.value));
    });
  });

  // ── Expiry default ────────────────────────────────────────
  const todayStr = new Date().toLocaleDateString('en-CA');
  document.getElementById('alert-expiry').value = todayStr;

  // ── Build alert message string ────────────────────────────
  function buildAlertMessage() {
    const direction = directionChips.get();
    const action    = actionChips.get();
    const strike    = document.getElementById('alert-strike').value.trim();
    const expiryRaw = document.getElementById('alert-expiry').value;
    const price     = document.getElementById('alert-price').value.trim();
    const notes     = document.getElementById('alert-notes').value.trim();

    if (!direction || !action) return null;

    let expiryStr = '';
    if (expiryRaw) {
      const p = expiryRaw.split('-');
      expiryStr = parseInt(p[1]) + '/' + parseInt(p[2]);
    }

    const dirEmoji = direction === 'CALL' ? '🟢' : '🔴';
    let msg = action + ' | SPX ' + direction + ' ' + dirEmoji;
    if (strike)    msg += ' ' + strike;
    if (expiryStr) msg += ' ' + expiryStr;
    if (price)     msg += ' @ $' + parseFloat(price).toFixed(2);
    if (notes)     msg += '\n\n📌 ' + notes;

    return { message: msg, direction, dirEmoji, notes };
  }

  // ── Update live preview ───────────────────────────────────
  function updatePreview() {
    const result  = buildAlertMessage();
    const preview = document.getElementById('live-preview');
    const lpTitle = document.getElementById('lp-title');
    const lpBody  = document.getElementById('lp-body');
    const lpFoot  = document.getElementById('lp-footer');

    if (!result) {
      preview.className = 'live-preview';
      lpTitle.textContent = '⚡ SPX Alert';
      lpBody.textContent  = 'Select direction + action to preview...';
      lpBody.className    = 'lp-body empty';
      lpFoot.textContent  = '';
      return;
    }

    const accent = result.direction === 'CALL' ? 'green' : 'red';
    preview.className   = 'live-preview ' + accent;
    lpTitle.textContent = result.dirEmoji + ' SPX Alert';
    lpBody.textContent  = result.message;
    lpBody.className    = 'lp-body';
    lpFoot.textContent  = new Date().toLocaleString('en-US', {
      month:'short', day:'numeric', hour:'numeric', minute:'2-digit', hour12:true
    }) + ' CT';
  }

  // Hook all alert inputs to live preview
  const directionChips = makeChips('direction-chips', updatePreview);
  const actionChips    = makeChips('action-chips',    updatePreview);
  const reviewTypeChips = makeChips('review-type-chips');

  ['alert-strike','alert-expiry','alert-price','alert-notes'].forEach(id => {
    document.getElementById(id).addEventListener('input', updatePreview);
    document.getElementById(id).addEventListener('change', updatePreview);
  });

  // ── Send function ─────────────────────────────────────────
  async function sendAlert(payload) {
    const res = await fetch('/.netlify/functions/send-alert', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    });
    if (!res.ok) throw new Error(await res.text());
    return res.json();
  }

  // ── SPX Alert send ────────────────────────────────────────
  document.getElementById('alert-btn').addEventListener('click', async () => {
    const result   = buildAlertMessage();
    const imageUrl = document.getElementById('alert-image-url').value.trim();

    if (!result) {
      showStatus('alert-status', 'Select direction + action first.', 'warn');
      return;
    }

    const btn = document.getElementById('alert-btn');
    btn.disabled    = true;
    btn.textContent = 'Sending...';

    try {
      const notes = document.getElementById('alert-notes').value.trim();
      // strip notes from message for clean storage, pass separately
      const baseMsg = result.message.split('\n\n📌')[0];
      await sendAlert({ title: 'SPX Alert', message: baseMsg, notes: notes || null, imageUrl: imageUrl || null });
      showStatus('alert-status', '✅ Alert sent!', 'success');
      ['alert-strike','alert-price','alert-notes','alert-image-url'].forEach(id =>
        document.getElementById(id).value = ''
      );
      document.getElementById('alert-expiry').value = todayStr;
      // reset chips
      document.getElementById('direction-chips').querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
      document.getElementById('action-chips').querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
      updatePreview();
    } catch (err) {
      showStatus('alert-status', '❌ ' + err.message, 'error');
    } finally {
      btn.disabled    = false;
      btn.textContent = '✈️ Send Alert';
    }
  });

  // ── Adhoc Note send ───────────────────────────────────────
  document.getElementById('adhoc-btn').addEventListener('click', async () => {
    const note     = document.getElementById('adhoc-input').value.trim();
    const imageUrl = document.getElementById('adhoc-image-url').value.trim();

    if (!note) { showStatus('adhoc-status', 'Write a note first.', 'warn'); return; }

    const btn = document.getElementById('adhoc-btn');
    btn.disabled    = true;
    btn.textContent = 'Sending...';

    try {
      await sendAlert({ title: '📝📝 Note from Rose', message: note, imageUrl: imageUrl || null });
      showStatus('adhoc-status', '✅ Note sent!', 'success');
      document.getElementById('adhoc-input').value     = '';
      document.getElementById('adhoc-image-url').value = '';
    } catch (err) {
      showStatus('adhoc-status', '❌ ' + err.message, 'error');
    } finally {
      btn.disabled    = false;
      btn.textContent = '💬 Send Note';
    }
  });

  // ── Market Review send ────────────────────────────────────
  document.getElementById('review-btn').addEventListener('click', async () => {
    const reviewType = reviewTypeChips.get();
    const review     = document.getElementById('review-input').value.trim();
    const imageUrl   = document.getElementById('review-image-url').value.trim();

    if (!reviewType) { showStatus('review-status', 'Select Pre or Post market.', 'warn'); return; }
    if (!review)     { showStatus('review-status', 'Write your review first.', 'warn'); return; }

    const btn = document.getElementById('review-btn');
    btn.disabled    = true;
    btn.textContent = 'Sending...';

    try {
      await sendAlert({ title: reviewType, message: review, imageUrl: imageUrl || null });
      showStatus('review-status', '✅ Review posted!', 'success');
      document.getElementById('review-input').value     = '';
      document.getElementById('review-image-url').value = '';
      document.getElementById('review-type-chips').querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
    } catch (err) {
      showStatus('review-status', '❌ ' + err.message, 'error');
    } finally {
      btn.disabled    = false;
      btn.textContent = '✏️ Post Review';
    }
  });
  // ── Swing Alert chips ─────────────────────────────────────
  const swingDirectionChips = makeChips('swing-direction-chips', updateSwingPreview);
  const swingActionChips    = makeChips('swing-action-chips',    updateSwingPreview);

  ['swing-ticker','swing-notes'].forEach(id => {
    document.getElementById(id).addEventListener('input', updateSwingPreview);
  });

  // Auto-uppercase ticker
  document.getElementById('swing-ticker').addEventListener('input', function() {
    const pos = this.selectionStart;
    this.value = this.value.toUpperCase();
    this.setSelectionRange(pos, pos);
  });

  // ── Build swing alert message ─────────────────────────────
  function buildSwingMessage() {
    const ticker    = document.getElementById('swing-ticker').value.trim().toUpperCase();
    const direction = swingDirectionChips.get();
    const action    = swingActionChips.get();
    const notes     = document.getElementById('swing-notes').value.trim();

    if (!direction || !action) return null;

    const dirEmoji = direction === 'LONG' ? '🟢' : '🔴';
    let msg = action + ' | ' + (ticker || 'TICKER') + ' ' + direction + ' ' + dirEmoji;
    if (notes) msg += '\n\n📌 ' + notes;

    return { message: msg, direction, dirEmoji, ticker, notes };
  }

  // ── Update swing preview ──────────────────────────────────
  function updateSwingPreview() {
    const result  = buildSwingMessage();
    const preview = document.getElementById('swing-live-preview');
    const lpTitle = document.getElementById('swing-lp-title');
    const lpBody  = document.getElementById('swing-lp-body');
    const lpFoot  = document.getElementById('swing-lp-footer');

    if (!result) {
      preview.className   = 'live-preview';
      lpTitle.textContent = '📊 Swing Alert';
      lpBody.textContent  = 'Select ticker + direction + action to preview...';
      lpBody.className    = 'lp-body empty';
      lpFoot.textContent  = '';
      return;
    }

    const accent = result.direction === 'LONG' ? 'green' : 'red';
    preview.className   = 'live-preview ' + accent;
    lpTitle.textContent = result.dirEmoji + ' Swing Alert' + (result.ticker ? ' — ' + result.ticker : '');
    lpBody.textContent  = result.message;
    lpBody.className    = 'lp-body';
    lpFoot.textContent  = new Date().toLocaleString('en-US', {
      month:'short', day:'numeric', hour:'numeric', minute:'2-digit', hour12:true
    }) + ' CT';
  }

  // ── Send Swing Alert ──────────────────────────────────────
  document.getElementById('swing-btn').addEventListener('click', async () => {
    const result   = buildSwingMessage();
    const imageUrl = document.getElementById('swing-image-url').value.trim();
    const ticker   = document.getElementById('swing-ticker').value.trim().toUpperCase();

    if (!ticker)  { showStatus('swing-status', 'Enter a ticker first.', 'warn'); return; }
    if (!result)  { showStatus('swing-status', 'Select direction + action first.', 'warn'); return; }

    const btn = document.getElementById('swing-btn');
    btn.disabled    = true;
    btn.textContent = 'Sending...';

    try {
      const notes   = document.getElementById('swing-notes').value.trim();
      const baseMsg = result.message.split('\n\n📌')[0];
      await sendAlert({
        title:    'Swing Alert',
        message:  baseMsg,
        notes:    notes || null,
        imageUrl: imageUrl || null,
        ticker,
        swingOnly: true,
      });
      showStatus('swing-status', '✅ Swing alert sent!', 'success');
      ['swing-ticker','swing-notes','swing-image-url'].forEach(id =>
        document.getElementById(id).value = ''
      );
      document.getElementById('swing-direction-chips').querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
      document.getElementById('swing-action-chips').querySelectorAll('.chip').forEach(b => b.classList.remove('active'));
      updateSwingPreview();
    } catch (err) {
      showStatus('swing-status', '❌ ' + err.message, 'error');
    } finally {
      btn.disabled    = false;
      btn.textContent = '📊 Send Swing Alert';
    }
  });
</script>

</body>
</html>