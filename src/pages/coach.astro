---
// Private coaching chat. Not linked from the nav; noindex. Standalone (no site Layout) so it
// behaves like an app when installed to the home screen.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0B0C15" />
  <link rel="manifest" href="/coach.webmanifest" />
  <title>Coach</title>
  <style>
    :root {
      --bg: #0B0C15;
      --card: #1C1E2D;
      --text: #E0E0E0;
      --muted: #8E90A6;
      --purple: #998BFF;
      --blue: #5F5CFF;
      --line: #2A2D42;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body {
      background: var(--bg); color: var(--text);
      font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      display: flex; flex-direction: column;
      padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
    }
    button, textarea, input { font: inherit; color: inherit; }
    :focus-visible { outline: 2px solid var(--purple); outline-offset: 2px; }

    header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 18px; border-bottom: 1px solid var(--line);
    }
    h1 { margin: 0; font-size: 1.15rem; font-weight: 650; color: var(--purple); }
    .count { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: .9rem; }
    .pips { display: flex; gap: 6px; }
    .pip { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--purple); }
    .pip.on { background: var(--purple); }
    .pips.over .pip { border-color: #FF7A8A; background: #FF7A8A; }
    .undo { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; padding: 4px; }

    main { flex: 1; overflow-y: auto; padding: 18px; display: flex; flex-direction: column; gap: 10px; }
    .msg { max-width: 85%; padding: 10px 14px; border-radius: 16px; white-space: pre-wrap; }
    .coach { background: var(--card); align-self: flex-start; border-bottom-left-radius: 4px; }
    .you { background: transparent; border: 1px solid var(--line); align-self: flex-end; border-bottom-right-radius: 4px; color: var(--muted); }
    .empty { color: var(--muted); margin: auto 0; text-align: center; }

    footer { padding: 12px 18px 16px; border-top: 1px solid var(--line); display: grid; gap: 10px; }
    .tilt {
      width: 100%; padding: 18px; border: 0; border-radius: 14px;
      background: var(--blue); color: #fff; font-size: 1.15rem; font-weight: 650; cursor: pointer;
    }
    .tilt:active { transform: scale(.98); }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .quick {
      padding: 12px; border-radius: 12px; border: 1px solid var(--line);
      background: var(--card); cursor: pointer;
    }
    form { display: flex; gap: 8px; }
    textarea {
      flex: 1; resize: none; min-height: 44px; max-height: 120px; padding: 10px 12px;
      background: var(--card); border: 1px solid var(--line); border-radius: 12px;
    }
    .send { padding: 0 16px; border: 0; border-radius: 12px; background: var(--purple); color: var(--bg); font-weight: 650; cursor: pointer; }
    button:disabled { opacity: .5; cursor: wait; }

    /* First-run setup */
    .setup { max-width: 420px; margin: auto; padding: 24px 18px; display: grid; gap: 12px; }
    .setup p { margin: 0; color: var(--muted); }
    .setup input { padding: 12px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; }
    .notice { font-size: .9rem; color: var(--muted); text-align: center; }
    .notice button { background: none; border: 0; color: var(--purple); text-decoration: underline; cursor: pointer; padding: 0; }
    .app { display: contents; }
    [hidden] { display: none !important; }

    @media (prefers-reduced-motion: reduce) { .tilt:active { transform: none; } }
  </style>
</head>
<body>
  <section class="setup" id="setup" hidden>
    <h1>Coach</h1>
    <p>Enter your coach passphrase to unlock this device.</p>
    <input id="pass" type="password" autocomplete="current-password" aria-label="Passphrase" />
    <button class="send" id="unlock" style="padding:12px">Unlock</button>
    <p id="setupError" role="alert"></p>
  </section>

  <div id="app" class="app" hidden>
    <header>
      <h1>Coach</h1>
      <div class="count">
        <div class="pips" id="pips" aria-hidden="true"></div>
        <span id="countText">0 of 3 trades</span>
        <button class="undo" id="undo">Undo</button>
      </div>
    </header>

    <main id="thread" aria-live="polite"></main>

    <footer>
      <p class="notice" id="notice" hidden>
        Notifications are off. <button id="enable">Turn on notifications</button>
      </p>
      <p class="notice" id="testRow" hidden>
        <button id="test">Send test notification</button> <span id="testResult" role="status"></span>
      </p>
      <button class="tilt" data-button="tilted">I'm feeling tilted</button>
      <div class="row">
        <button class="quick" data-button="logged">Logged a trade</button>
        <button class="quick" data-button="reset">I'm reset</button>
      </div>
      <form id="form">
        <textarea id="text" rows="1" placeholder="Tell the coach what's going on" aria-label="Message"></textarea>
        <button class="send" type="submit">Send</button>
      </form>
    </footer>
  </div>

  <script is:inline>
    const KEY = "coach-key";
    const $ = (id) => document.getElementById(id);
    const key = () => localStorage.getItem(KEY);

    async function api(method, body) {
      const res = await fetch("/api/coach", {
        method,
        headers: { "Content-Type": "application/json", "x-coach-key": key() || "" },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 403) { localStorage.removeItem(KEY); showSetup("That passphrase didn't work. Try again."); throw new Error("forbidden"); }
      if (!res.ok) throw new Error("Coach returned " + res.status);
      return res.json();
    }

    function renderCount(trades, max) {
      const pips = $("pips");
      pips.innerHTML = "";
      for (let i = 0; i < max; i++) {
        const d = document.createElement("span");
        d.className = "pip" + (i < trades ? " on" : "");
        pips.appendChild(d);
      }
      pips.classList.toggle("over", trades > max);
      $("countText").textContent = `${trades} of ${max} trades`;
    }

    function addMsg(who, text) {
      $("thread").querySelector(".empty")?.remove();
      const div = document.createElement("div");
      div.className = "msg " + who;
      div.textContent = text;
      $("thread").appendChild(div);
      div.scrollIntoView({ block: "end" });
    }

    async function send(payload, label) {
      const buttons = document.querySelectorAll("footer button");
      buttons.forEach((b) => (b.disabled = true));
      addMsg("you", label);
      try {
        const data = await api("POST", payload);
        addMsg("coach", data.reply);
        renderCount(data.trades, data.max);
      } catch (err) {
        if (err.message !== "forbidden") addMsg("coach", "Couldn't reach the coach. Check your connection and send again.");
      } finally {
        buttons.forEach((b) => (b.disabled = false));
      }
    }

    function showSetup(msg) {
      $("app").hidden = true;
      $("setup").hidden = false;
      $("setupError").textContent = msg || "";
    }

    async function loadThread() {
      $("setup").hidden = true;
      $("app").hidden = false;
      const data = await api("GET");
      renderCount(data.trades, data.max);
      $("thread").innerHTML = "";
      if (!data.log.length) {
        const p = document.createElement("p");
        p.className = "empty";
        p.textContent = "No messages yet today. Check-ins start at 9:00 ET.";
        $("thread").appendChild(p);
      }
      data.log.forEach((m) => addMsg(m.who, m.text));
      refreshNotice();
    }

    // --- Push ---
    function urlB64ToUint8Array(b64) {
      const pad = "=".repeat((4 - (b64.length % 4)) % 4);
      const raw = atob((b64 + pad).replace(/-/g, "+").replace(/_/g, "/"));
      return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
    }

    async function refreshNotice() {
      if (!("serviceWorker" in navigator) || !("PushManager" in window)) { $("notice").hidden = true; return; }
      const reg = await navigator.serviceWorker.register("/coach-sw.js", { scope: "/coach" });
      const sub = await reg.pushManager.getSubscription();
      const on = !!sub && Notification.permission === "granted";
      $("notice").hidden = on;
      $("testRow").hidden = !on;
    }

    async function enablePush() {
      const perm = await Notification.requestPermission();
      if (perm !== "granted") { alert("Notifications are blocked. Allow them for rose.trading in Chrome's site settings, then try again."); return; }
      const reg = await navigator.serviceWorker.register("/coach-sw.js", { scope: "/coach" });
      const { publicKey } = await (await fetch("/api/coach/subscribe")).json();
      const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlB64ToUint8Array(publicKey) });
      const res = await fetch("/api/coach/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-coach-key": key() },
        body: JSON.stringify({ subscription: sub.toJSON() }),
      });
      if (!res.ok) { alert("Couldn't save this device. Unlock again and retry."); return; }
      $("notice").hidden = true;
      $("testRow").hidden = false;
    }

    // --- Wire up ---
    const labels = { tilted: "Feeling tilted", logged: "Logged a trade", reset: "I'm reset" };
    document.querySelectorAll("[data-button]").forEach((b) =>
      b.addEventListener("click", () => send({ button: b.dataset.button }, labels[b.dataset.button]))
    );

    $("form").addEventListener("submit", (e) => {
      e.preventDefault();
      const text = $("text").value.trim();
      if (!text) return;
      $("text").value = "";
      send({ text }, text);
    });
    $("text").addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("form").requestSubmit(); }
    });

    $("undo").addEventListener("click", async () => {
      const data = await api("POST", { undo: true });
      renderCount(data.trades, data.max);
    });

    $("enable").addEventListener("click", enablePush);

    $("test").addEventListener("click", async () => {
      $("test").disabled = true;
      $("testResult").textContent = "Sending...";
      try {
        const r = await api("POST", { test: true });
        const plural = (n) => `${n} device${n === 1 ? "" : "s"}`;
        $("testResult").textContent =
          r.sent || r.failed
            ? `Sent to ${plural(r.sent)}.` + (r.failed ? ` ${plural(r.failed)} didn't respond.` : " It should appear in a few seconds.")
            : "No devices are signed up. Turn on notifications on this device first.";
      } catch (err) {
        if (err.message !== "forbidden") $("testResult").textContent = "Couldn't send. Check the coach-api function log in Netlify.";
      } finally {
        $("test").disabled = false;
      }
    });

    $("unlock").addEventListener("click", () => {
      const v = $("pass").value.trim();
      if (!v) return;
      localStorage.setItem(KEY, v);
      loadThread().catch(() => {});
    });
    $("pass").addEventListener("keydown", (e) => { if (e.key === "Enter") $("unlock").click(); });

    key() ? loadThread().catch(() => {}) : showSetup();
  </script>
</body>
</html>
