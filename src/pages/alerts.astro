---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trade Alerts | Rose Trading">

  <section class="alerts-page">
    <div class="page-header">
      <h1 class="page-title">Trade Alerts</h1>
      <p class="page-sub">Real-time SPX trade alerts and pre/post market reviews from Rose.</p>
    </div>

    <!-- Lock Banner -->
    <div class="lock-banner">
      <div class="lock-banner-left">
        <span class="lock-icon">🔒</span>
        <div>
          <div class="lock-title">Members Only</div>
          <div class="lock-desc">Get live SPX alerts straight to your phone for <strong>$39.99/mo</strong></div>
        </div>
      </div>
      <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="unlock-btn">
        Unlock Alerts →
      </a>
    </div>

    <!-- Blurred Feed Preview -->
    <div class="feed-wrap">
      <div class="feed-blur-overlay">
        <div class="overlay-card">
          <div class="overlay-icon">📡</div>
          <h2 class="overlay-title">Subscribe to See Live Alerts</h2>
          <p class="overlay-sub">Real-time SPX entries, exits, and daily market reviews — delivered to your phone the moment Rose trades.</p>
          <div class="price-badge">$39.99 / month</div>
          <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="overlay-btn">
            🔓 Unlock Full Access
          </a>
          <p class="overlay-fine">Instant access · Cancel anytime</p>
        </div>
      </div>

      <!-- Fake blurred cards underneath -->
      <div class="feed blurred" aria-hidden="true">
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">🚨 ALERT</span>
            <span class="card-time">Today, 9:47 AM CT</span>
          </div>
          <div class="card-message">LONG 🟢 ENTRY | ORB @ 5412 — clean break above initial balance</div>
        </div>
        <div class="feed-card type-review">
          <div class="card-header">
            <span class="card-tag">☀️ PRE-MARKET</span>
            <span class="card-time">Today, 8:15 AM CT</span>
          </div>
          <div class="card-message">Watching 5400 as key support. Phase oscillator showing bullish momentum. Bias is long above 5395, looking for ORB setup at open. ATR levels are tight so will size accordingly.</div>
        </div>
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">🚨 ALERT</span>
            <span class="card-time">Yesterday, 2:48 PM CT</span>
          </div>
          <div class="card-message">SHORT 🔴 EXIT ✅ | Tweezer Bottom — took profits at target</div>
        </div>
        <div class="feed-card type-review">
          <div class="card-header">
            <span class="card-tag">🌙 POST-MARKET</span>
            <span class="card-time">Yesterday, 4:05 PM CT</span>
          </div>
          <div class="card-message">Great follow-through today. Both trades hit target. Market respected pivot ribbon all day. Tomorrow watching for continuation or failed auction at highs.</div>
        </div>
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">🚨 ALERT</span>
            <span class="card-time">Yesterday, 10:22 AM CT</span>
          </div>
          <div class="card-message">SHORT 🔴 ENTRY | Divergence From Extreme @ 5388 — phase osc diverging</div>
        </div>
      </div>
    </div>

    <!-- Value props -->
    <div class="value-grid">
      <div class="value-card">
        <div class="value-icon">⚡</div>
        <h3>Instant Push Alerts</h3>
        <p>Get notified the moment Rose enters or exits a trade — right on your iPhone or Android.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">☀️</div>
        <h3>Daily Market Reviews</h3>
        <p>Pre-market bias and post-market breakdowns every trading day.</p>
      </div>
      <div class="value-card">
        <div class="value-icon">📈</div>
        <h3>SPX Options Focus</h3>
        <p>All alerts are SPX 0DTE options trades using #TheStrat and Saty's indicators.</p>
      </div>
    </div>

    <div class="bottom-cta">
      <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="overlay-btn large-btn">
        🔓 Get Access for $39.99/mo
      </a>
      <p class="overlay-fine">Cancel anytime from your Whop dashboard</p>
    </div>

  </section>
</Layout>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --bg:      #0B0C15;
    --surface: #1C1E2D;
    --border:  rgba(153,139,255,0.15);
    --purple:  #998BFF;
    --blue:    #5F5CFF;
    --green:   #3DDC84;
    --red:     #FF5C5C;
    --text:    #E0E0E0;
    --muted:   #555;
  }

  :global(body) { background: var(--bg); color: var(--text); }

  .alerts-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* Header */
  .page-header { text-align: center; margin-bottom: 2rem; }

  .page-title {
    font-family: 'Syne', sans-serif;
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--purple);
    margin-bottom: 0.75rem;
  }
  .page-sub { color: var(--muted); font-size: 1rem; }

  /* Lock Banner */
  .lock-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(95,92,255,0.08);
    border: 1px solid rgba(95,92,255,0.25);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .lock-banner-left { display: flex; align-items: center; gap: 0.85rem; }
  .lock-icon  { font-size: 1.4rem; }
  .lock-title { font-weight: 700; color: var(--text); font-size: 0.95rem; }
  .lock-desc  { color: var(--muted); font-size: 0.82rem; margin-top: 0.1rem; }
  .lock-desc strong { color: var(--purple); }

  .unlock-btn {
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    padding: 0.55rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .unlock-btn:hover { opacity: 0.85; }

  /* Feed wrap + blur */
  .feed-wrap {
    position: relative;
    margin-bottom: 3rem;
  }

  .feed-blur-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to bottom,
      rgba(11,12,21,0) 0%,
      rgba(11,12,21,0.75) 20%,
      rgba(11,12,21,0.97) 45%
    );
    border-radius: 12px;
    padding: 1rem;
  }

  .overlay-card {
    text-align: center;
    max-width: 420px;
    padding: 2rem 1.5rem;
    background: var(--surface);
    border: 1px solid rgba(153,139,255,0.25);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    margin-top: 8rem;
  }

  .overlay-icon  { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .overlay-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .overlay-sub {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .price-badge {
    display: inline-block;
    background: rgba(153,139,255,0.1);
    border: 1px solid rgba(153,139,255,0.3);
    color: var(--purple);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0.4rem 1rem;
    border-radius: 8px;
    margin-bottom: 1.25rem;
  }

  .overlay-btn {
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    padding: 0.85rem 2rem;
    border-radius: 10px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.03em;
    transition: opacity 0.15s, transform 0.1s;
    margin-bottom: 0.75rem;
    display: block;
  }
  .overlay-btn:hover { opacity: 0.9; transform: translateY(-1px); }
  .overlay-fine { font-size: 0.75rem; color: var(--muted); }

  /* Blurred feed */
  .feed { display: flex; flex-direction: column; gap: 1rem; }
  .blurred {
    filter: blur(5px);
    pointer-events: none;
    user-select: none;
  }

  .feed-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 4px solid transparent;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }
  .feed-card.type-alert  { border-left-color: var(--red); }
  .feed-card.type-review { border-left-color: var(--purple); }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .card-tag  { font-size: 0.65rem; letter-spacing: 0.15em; font-family: 'JetBrains Mono', monospace; }
  .card-time { font-size: 0.72rem; color: var(--muted); font-family: 'JetBrains Mono', monospace; }
  .type-alert  .card-tag { color: var(--red); }
  .type-review .card-tag { color: var(--purple); }
  .card-message { font-size: 0.95rem; line-height: 1.65; color: var(--text); }
  .type-alert .card-message { font-weight: 600; }

  /* Value Grid */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: border-color 0.2s;
  }
  .value-card:hover { border-color: rgba(153,139,255,0.35); }
  .value-icon    { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .value-card h3 { color: var(--purple); font-size: 0.95rem; margin-bottom: 0.5rem; }
  .value-card p  { color: var(--muted); font-size: 0.82rem; line-height: 1.55; }

  /* Bottom CTA */
  .bottom-cta { text-align: center; }
  .large-btn  { max-width: 340px; margin: 0 auto 0.75rem; font-size: 1.05rem; padding: 1rem 2rem; }

  @media (max-width: 600px) {
    .page-title   { font-size: 2rem; }
    .lock-banner  { flex-direction: column; align-items: flex-start; }
    .overlay-card { margin-top: 5rem; }
  }
</style>