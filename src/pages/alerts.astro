---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Trade Alerts | Rose Trading">

<Fragment slot="head">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
</Fragment>

  <section class="alerts-page">
    <div class="page-header">
      <h1 class="page-title">Trade Alerts</h1>
      <p class="page-sub">Real-time SPX trade alerts and pre/post market reviews from Rose.</p>
    </div>

    <!-- Lock Banner -->
    <div class="lock-banner">
      <div class="lock-banner-left">
        <span class="lock-icon"><Icon name="lucide:lock" /></span>
        <div>
          <div class="lock-title">Members Only</div>
          <div class="lock-desc">Get live SPX alerts straight to your phone for <strong>Adex Members/mo</strong></div>
        </div>
      </div>
      <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="unlock-btn">
        Unlock Alerts →
      </a>
    </div>

    <!-- Adex Trades cross-promo -->
    <div class="adex-banner">
      <div class="adex-banner-left">
        <span class="lock-icon"><Icon name="lucide:zap" /></span>
        <div>
          <div class="lock-title">Adex Trades Member?</div>
          <div class="lock-desc">Diamond members get access to these alerts too — no extra charge.</div>
        </div>
      </div>
      <div class="adex-banner-actions">
        <a href="/.netlify/functions/discord-login" class="adex-signin-btn">Sign in with Discord</a>
        <a href="https://whop.com/checkout/plan_0S7UBXkzD2JTf?a=user1ec11086429" target="_blank" class="unlock-btn">
          Join Adex Trades →
        </a>
      </div>
    </div>

    <!-- Blurred Feed Preview -->
    <div class="feed-wrap">
      <div class="feed-blur-overlay">
        <div class="overlay-card">
          <div class="overlay-icon"><Icon name="lucide:radio-tower" /></div>
          <h2 class="overlay-title">Subscribe to See Live Alerts</h2>
          <p class="overlay-sub">Real-time SPX entries, exits, and daily market reviews — delivered to your phone the moment Rose trades.</p>
          <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="overlay-btn">
            <Icon name="lucide:unlock" /> Unlock Full Access
          </a>
          <p class="overlay-fine">Instant access · Cancel anytime</p>
        </div>
      </div>

      <!-- Fake blurred cards underneath -->
      <div class="feed blurred" aria-hidden="true">
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">ALERT</span>
            <span class="card-time">Today, 9:47 AM CT</span>
          </div>
          <div class="card-message">🚀 ENTRY | SPX CALL 🟢 5412 4/22 @ $1.20</div>
        </div>
        <div class="feed-card type-review">
          <div class="card-header">
            <span class="card-tag">PRE-MARKET</span>
            <span class="card-time">Today, 8:15 AM CT</span>
          </div>
          <div class="card-message">Watching 5400 as key support. Phase oscillator showing bullish momentum. Bias is long above 5395, looking for ORB setup at open.</div>
        </div>
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">ALERT</span>
            <span class="card-time">Yesterday, 2:48 PM CT</span>
          </div>
          <div class="card-message">✅ EXIT | SPX CALL 🟢 5400 4/21 @ $2.55</div>
        </div>
        <div class="feed-card type-review">
          <div class="card-header">
            <span class="card-tag">POST-MARKET</span>
            <span class="card-time">Yesterday, 4:05 PM CT</span>
          </div>
          <div class="card-message">Great follow-through today. Both trades hit target. Market respected pivot ribbon all day.</div>
        </div>
        <div class="feed-card type-alert">
          <div class="card-header">
            <span class="card-tag">ALERT</span>
            <span class="card-time">Yesterday, 10:22 AM CT</span>
          </div>
          <div class="card-message">❌ STOP HIT | SPX PUT 🔴 5380 4/21 @ $0.85</div>
        </div>
      </div>
    </div>

    <!-- Value props -->
    <div class="value-grid">
      <div class="value-card">
        <div class="value-icon"><Icon name="lucide:bell-ring" /></div>
        <h3>Instant Push Alerts</h3>
        <p>Get notified the moment Rose enters or exits a trade — right on your iPhone or Android.</p>
      </div>
      <div class="value-card">
        <div class="value-icon"><Icon name="lucide:sun" /></div>
        <h3>Daily Market Reviews</h3>
        <p>Pre-market bias and post-market breakdowns every trading day.</p>
      </div>
      <div class="value-card">
        <div class="value-icon"><Icon name="lucide:trending-up" /></div>
        <h3>SPX Options Focus</h3>
        <p>All alerts are SPX 0DTE options trades using #TheStrat and Saty's indicators.</p>
      </div>
    </div>

    <div class="bottom-cta">
      <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" target="_blank" class="overlay-btn large-btn">
        <Icon name="lucide:unlock" /> Get Access for $39.99/mo
      </a>
      <p class="overlay-fine">Cancel anytime from your Whop dashboard</p>
    </div>

  </section>
</Layout>

<style>
  :root {
    --bg:      #0B0C15;
    --surface: #1C1E2D;
    --border:  rgba(153,139,255,0.15);
    --purple:  #998BFF;
    --blue:    #5F5CFF;
    --green:   #3DDC84;
    --red:     #FF5C5C;
    --text:    #E0E0E0;
    --muted:   #555;
  }

  :global(body) { background: var(--bg); color: var(--text); }

  .alerts-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  /* Header */
  .page-header { text-align: center; margin-bottom: 2rem; }

  .page-title {
    font-family: 'Syne', sans-serif !important;
    font-size: 2.8rem;
    font-weight: 800;
    background: linear-gradient(135deg, #998BFF, #5F5CFF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }
  .page-sub { color: var(--muted); font-size: 1rem; }

  /* Lock Banner */
  .lock-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(95,92,255,0.08);
    border: 1px solid rgba(95,92,255,0.25);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .lock-banner-left { display: flex; align-items: center; gap: 0.85rem; }
  .lock-icon  { display: flex; color: var(--purple); }
  .lock-icon [data-icon] { width: 20px; height: 20px; }
  .lock-title { font-weight: 700; color: var(--text); font-size: 0.95rem; font-family: 'Syne', sans-serif; }
  .lock-desc  { color: var(--muted); font-size: 0.82rem; margin-top: 0.1rem; }
  .lock-desc strong { color: var(--purple); }

  .unlock-btn {
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    padding: 0.55rem 1.25rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    font-family: 'Syne', sans-serif;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .unlock-btn:hover { opacity: 0.85; }

  /* Adex Trades cross-promo */
  .adex-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(153,139,255,0.06);
    border: 1px solid rgba(153,139,255,0.25);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .adex-banner-left { display: flex; align-items: center; gap: 0.85rem; }
  .adex-banner-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .adex-signin-btn {
    background: transparent;
    border: 1px solid rgba(153,139,255,0.4);
    color: var(--purple);
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    font-family: 'Syne', sans-serif;
    white-space: nowrap;
    transition: background 0.15s, border-color 0.15s;
  }
  .adex-signin-btn:hover { background: rgba(153,139,255,0.1); border-color: var(--purple); }

  /* Feed wrap + blur */
  .feed-wrap { position: relative; margin-bottom: 3rem; }

  .feed-blur-overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to bottom,
      rgba(11,12,21,0) 0%,
      rgba(11,12,21,0.75) 20%,
      rgba(11,12,21,0.97) 45%
    );
    border-radius: 12px;
    padding: 1rem;
  }

  .overlay-card {
    text-align: center;
    max-width: 420px;
    padding: 2rem 1.5rem;
    background: var(--surface);
    border: 1px solid rgba(153,139,255,0.25);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    margin-top: 8rem;
  }

  .overlay-icon {
    display: flex;
    justify-content: center;
    color: var(--purple);
    margin-bottom: 0.75rem;
  }
  .overlay-icon [data-icon] { width: 40px; height: 40px; }

  .overlay-title {
    font-family: 'Syne', sans-serif !important;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .overlay-sub {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .overlay-btn {
    background: var(--blue);
    color: #fff;
    text-decoration: none;
    padding: 0.85rem 2rem;
    border-radius: 10px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.03em;
    transition: opacity 0.15s, transform 0.1s;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .overlay-btn [data-icon] { width: 18px; height: 18px; }
  .overlay-btn:hover { opacity: 0.9; transform: translateY(-1px); }
  .overlay-fine { font-size: 0.75rem; color: var(--muted); }

  /* Blurred feed */
  .feed { display: flex; flex-direction: column; gap: 1rem; }
  .blurred { filter: blur(5px); pointer-events: none; user-select: none; }

  .feed-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .feed-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
  }
  .type-alert::before  { background: var(--red); }
  .type-review::before { background: var(--purple); }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .card-tag {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
  .type-alert  .card-tag { color: var(--red);    background: rgba(255,92,92,0.1);   border: 1px solid rgba(255,92,92,0.2); }
  .type-review .card-tag { color: var(--purple); background: rgba(153,139,255,0.1); border: 1px solid rgba(153,139,255,0.2); }
  .card-time { font-size: 0.72rem; color: var(--muted); font-family: 'JetBrains Mono', monospace; }

  .card-message { font-size: 0.95rem; line-height: 1.65; color: var(--text); }
  .type-alert .card-message { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; }

  /* Value Grid */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .value-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: border-color 0.2s;
  }
  .value-card:hover { border-color: rgba(153,139,255,0.35); }
  .value-icon {
    display: flex;
    justify-content: center;
    color: var(--purple);
    margin-bottom: 0.75rem;
  }
  .value-icon [data-icon] { width: 28px; height: 28px; }
  .value-card h3 { color: var(--purple); font-size: 0.95rem; margin-bottom: 0.5rem; font-family: 'Syne', sans-serif; }
  .value-card p  { color: var(--muted); font-size: 0.82rem; line-height: 1.55; }

  /* Bottom CTA */
  .bottom-cta { text-align: center; }
  .large-btn  { max-width: 340px; margin: 0 auto 0.75rem; font-size: 1.05rem; padding: 1rem 2rem; }

  @media (max-width: 600px) {
    .page-title   { font-size: 2rem; }
    .lock-banner  { flex-direction: column; align-items: flex-start; }
    .adex-banner  { flex-direction: column; align-items: flex-start; }
    .overlay-card { margin-top: 5rem; }
  }
</style>