---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Me | Rose Trading">
  <section class="about-hero">
   <div class="alert-cta">
  <button id="onesignal-button" class="enable-btn">
    <span class="bell-icon">🔔</span> Enable Trade Alerts
  </button>
</div>

<script is:inline>
  function onEnableAlertsClick() {
    const triggerPrompt = () => {
      if (window.OneSignal && window.OneSignal.Slidedown) {
        window.OneSignal.Slidedown.promptPush();
      } else {
        // If not ready, wait 500ms and try one more time
        setTimeout(() => {
          if (window.OneSignal?.Slidedown) {
            window.OneSignal.Slidedown.promptPush();
          } else {
            alert("Connection to alert server is slow. Please refresh the page.");
          }
        }, 500);
      }
    };

    triggerPrompt();
  }
</script>

      <h1 class="page-title">About Me</h1>
      
      <div class="about-grid">
        <div class="profile-frame">
          <img src="/rose-photo.jpg" alt="Rosemary Edmunds" class="profile-img" />
        </div>
        
        <div class="about-text">
          <h2>Hi, I'm Rose!</h2>
          <p>
            Rose is an IT Trading Analyst for a Fortune 500 company that lives in Houston, Texas. 
            She's a wife, dog mom, and cancer survivor who likes to play soccer, travel, and read in her free time.
          </p>
          <p>
            Rose started trading in 2020. She mainly focuses on options with a primary focus on SPX right now.
          </p>
          <p>
            Rose likes to use <strong>#TheStrat</strong> and Market Structure to swing trade and intraday trade. 
            She loves to pay it forward by teaching others what has brought her success in trading.
          </p>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">📈</div>
          <h3>My Approach</h3>
          <p>#TheStrat and Market Structure for swing and intraday trading</p>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🎯</div>
          <h3>Main Focus</h3>
          <p>SPX Options Trading</p>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🎓</div>
          <h3>My Mission</h3>
          <p>Teaching technical analysis, risk management, and trading psychology</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  function onEnableAlertsClick() {
    if (window.OneSignal) {
      window.OneSignal.Slidedown.promptPush().then(() => {
        console.log("Prompt shown");
      }).catch(err => {
        alert("Check your browser settings—notifications might be blocked.");
        console.error(err);
      });
    } else {
      alert("OneSignal is still loading... wait 2 seconds and try again.");
    }
  }
</script>

<style>
  /* Restore Dark Background and Text */
  :global(body) {
    background-color: #0b0b0b;
    color: #ffffff;
  }

  .about-hero {
    padding: 4rem 0;
  }

  .alert-banner {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .enable-btn {
    background: #e63946;
    color: white;
    border: none;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(230, 57, 70, 0.3);
    transition: transform 0.2s;
  }

  .enable-btn:active {
    transform: scale(0.95);
  }

  .page-title {
    text-align: center;
    font-size: 3rem;
    margin-bottom: 3rem;
    font-weight: 800;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  .profile-frame {
    border: 3px solid #e63946;
    border-radius: 20px;
    overflow: hidden;
    line-height: 0;
  }

  .profile-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about-text h2 {
    color: #e63946;
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .about-text p {
    line-height: 1.8;
    color: #ccc;
    margin-bottom: 1.2rem;
    font-size: 1.1rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .stat-card {
    background: #161616;
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #222;
  }

  .stat-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .stat-card h3 {
    color: #e63946;
    margin-bottom: 0.5rem;
  }

  .stat-card p {
    color: #888;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .page-title {
      font-size: 2.2rem;
    }
  }
</style>