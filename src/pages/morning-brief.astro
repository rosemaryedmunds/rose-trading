---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Morning Brief | Rose Trading">
  <main class="mb-container">
    <header class="mb-header">
      <div class="mb-header-left">
        <h1>Morning Brief</h1>
        <p id="mb-date" class="mb-date-display"></p>
      </div>
      <div class="mb-header-right">
        <span class="mb-badge">Gemini 2.5 · Live Search</span>
        <button id="refresh-btn" class="mb-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
          Refresh
        </button>
      </div>
    </header>

    <div id="loading-state" class="mb-status">
      <span class="spinner"></span> Scanning markets &amp; schedule...
    </div>
    <div id="error-state" class="mb-status error hidden"></div>

    <div id="brief-content" class="hidden">

      <!-- Row 1: Market Tone -->
      <section class="mb-card tone-card mb-row1">
        <div class="card-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          Market Tone &amp; Morning Bias
        </div>
        <div class="card-body tone-body">
          <div class="tone-section">
            <span class="tone-label">OVERVIEW</span>
            <p id="tone-text" class="tone-text"></p>
          </div>
          <div class="tone-divider"></div>
          <div class="tone-section">
            <span class="tone-label bias-label">BIAS &amp; WATCH</span>
            <p id="bias-text" class="bias-text"></p>
          </div>
        </div>
      </section>

      <!-- Row 2: 3 tiles -->
      <div class="mb-grid3 mb-row2">

        <section class="mb-card">
          <div class="card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            US Economic Calendar
          </div>
          <div class="card-body">
            <div id="econ-list"></div>
          </div>
        </section>

        <section class="mb-card">
          <div class="card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            Pre-Market Earnings Gaps
          </div>
          <div class="card-body">
            <div id="gaps-container"></div>
          </div>
        </section>

        <section class="mb-card">
          <div class="card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 0 0-2 2v6c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            Trump Schedule
          </div>
          <div class="card-body">
            <div id="trump-list"></div>
          </div>
        </section>

      </div>

      <!-- Row 3: Analyst + Catalyst -->
      <div class="mb-grid2 mb-row3">

        <section class="mb-card">
          <div class="card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
            Analyst Ratings
          </div>
          <div class="card-body">
            <div id="ratings-list"></div>
          </div>
        </section>

        <section class="mb-card">
          <div class="card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
            Catalyst News
          </div>
          <div class="card-body">
            <div id="news-list" class="news-grid"></div>
          </div>
        </section>

      </div>
    </div>
  </main>

  <style>
    :root {
      --bg-card: #1C1E2D;
      --border: #2d2f45;
      --accent: #998BFF;
      --text: #E0E0E0;
      --text-muted: #6b6d8a;
      --green: #4ade80;
      --red: #f87171;
      --amber: #f59e0b;
      --teal: #14b8a6;
      --purple: #8b5cf6;
      --orange: #f97316;
    }

    .mb-container { max-width: 1140px; margin: 0 auto; padding: 2rem 1.25rem 3rem; color: var(--text); font-family: system-ui, -apple-system, sans-serif; }

    /* Header */
    .mb-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
    .mb-header h1 { font-size: 1.4rem; font-weight: 700; margin: 0; color: var(--accent); }
    .mb-date-display { font-family: monospace; color: var(--text-muted); font-size: 0.78rem; margin-top: 0.3rem; }
    .mb-header-right { display: flex; align-items: center; gap: 0.75rem; }
    .mb-badge { font-size: 0.68rem; background: rgba(153,139,255,0.08); border: 1px solid rgba(153,139,255,0.3); color: var(--accent); padding: 0.2rem 0.55rem; border-radius: 20px; }
    .mb-btn { background: var(--accent); border: none; color: #0B0C15; padding: 0.4rem 0.85rem; border-radius: 8px; cursor: pointer; font-weight: 700; font-size: 0.78rem; display: flex; align-items: center; gap: 0.4rem; transition: opacity 0.2s; }
    .mb-btn:hover { opacity: 0.85; }

    /* Rows */
    .mb-row1 { margin-bottom: 1rem; }
    .mb-row2 { margin-bottom: 1rem; }
    .mb-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: stretch; }
    .mb-grid2 { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem; align-items: stretch; }

    /* Cards */
    .mb-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
    .tone-card { border-color: rgba(59,130,246,0.25); }
    .card-header { background: rgba(255,255,255,0.02); padding: 0.6rem 1rem; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 0.45rem; color: var(--text-muted); flex-shrink: 0; }
    .card-body { padding: 0.9rem 1rem; flex: 1; }

    /* Tone row */
    .tone-body { display: grid; grid-template-columns: 1fr auto 1fr; }
    .tone-section { display: flex; flex-direction: column; gap: 0.5rem; }
    .tone-label { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #3b82f6; }
    .bias-label { color: var(--accent) !important; }
    .tone-text { font-size: 0.88rem; line-height: 1.7; color: #c8c6e8; margin: 0; }
    .bias-text { font-size: 0.88rem; line-height: 1.7; color: #c8c6e8; margin: 0; }
    .tone-divider { width: 1px; background: var(--border); margin: 0 1.25rem; }

    /* ── Econ items ──────────────────────────────── */
    .econ-item { padding: 0.55rem 0; border-bottom: 1px solid var(--border); display: flex; align-items: flex-start; gap: 0.6rem; }
    .econ-item:last-child { border-bottom: none; padding-bottom: 0; }
    .econ-item:first-child { padding-top: 0; }
    .econ-impact-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 0.35rem; }
    .econ-impact-dot.HIGH { background: #ef4444; box-shadow: 0 0 5px rgba(239,68,68,0.5); }
    .econ-impact-dot.MED  { background: #f59e0b; box-shadow: 0 0 5px rgba(245,158,11,0.4); }
    .econ-impact-dot.LOW  { background: var(--text-muted); }
    .econ-body { flex: 1; min-width: 0; }
    .econ-name { font-size: 0.82rem; color: var(--text); font-weight: 500; line-height: 1.35; }
    .econ-meta { display: flex; gap: 0.6rem; margin-top: 0.2rem; flex-wrap: wrap; }
    .econ-time { font-size: 0.7rem; color: var(--text-muted); font-family: monospace; }
    .econ-actual { font-size: 0.7rem; color: var(--green); font-weight: 600; }
    .econ-forecast { font-size: 0.7rem; color: var(--text-muted); }

    /* ── Gap items ───────────────────────────────── */
    .gaps-label { font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; margin-top: 0.6rem; }
    .gaps-label:first-child { margin-top: 0; }
    .gaps-label.up { color: var(--green); }
    .gaps-label.down { color: var(--red); }
    .gap-item { padding: 0.55rem 0.7rem; margin-bottom: 0.4rem; border-radius: 8px; display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; }
    .gap-item:last-child { margin-bottom: 0; }
    .gap-item.up   { background: rgba(74,222,128,0.06); border: 1px solid rgba(74,222,128,0.15); }
    .gap-item.down { background: rgba(248,113,113,0.06); border: 1px solid rgba(248,113,113,0.15); }
    .gap-left { flex: 1; min-width: 0; }
    .gap-ticker { font-size: 0.82rem; font-weight: 800; font-family: monospace; }
    .gap-item.up   .gap-ticker { color: var(--green); }
    .gap-item.down .gap-ticker { color: var(--red); }
    .gap-desc { font-size: 0.72rem; color: var(--text-muted); margin-top: 0.15rem; line-height: 1.35; }
    .gap-move { font-size: 0.78rem; font-weight: 800; white-space: nowrap; font-family: monospace; flex-shrink: 0; }
    .gap-item.up   .gap-move { color: var(--green); }
    .gap-item.down .gap-move { color: var(--red); }

    /* ── Trump items ─────────────────────────────── */
    .trump-item { padding: 0.55rem 0; border-bottom: 1px solid var(--border); display: flex; gap: 0.75rem; align-items: flex-start; }
    .trump-item:last-child { border-bottom: none; padding-bottom: 0; }
    .trump-item:first-child { padding-top: 0; }
    .trump-time { font-size: 0.7rem; font-weight: 700; color: var(--purple); font-family: monospace; white-space: nowrap; padding-top: 0.1rem; min-width: 70px; }
    .trump-event { font-size: 0.82rem; color: var(--text); line-height: 1.4; }

    /* ── Analyst rating items ────────────────────── */
    .rating-item { padding: 0.55rem 0; border-bottom: 1px solid var(--border); }
    .rating-item:last-child { border-bottom: none; padding-bottom: 0; }
    .rating-item:first-child { padding-top: 0; }
    .rating-top { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.2rem; }
    .rating-badge { font-size: 0.6rem; font-weight: 800; padding: 0.15rem 0.4rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.05em; flex-shrink: 0; }
    .rating-badge.upgrade   { background: rgba(74,222,128,0.12); color: var(--green); border: 1px solid rgba(74,222,128,0.25); }
    .rating-badge.downgrade { background: rgba(248,113,113,0.12); color: var(--red); border: 1px solid rgba(248,113,113,0.25); }
    .rating-badge.initiated { background: rgba(153,139,255,0.12); color: var(--accent); border: 1px solid rgba(153,139,255,0.25); }
    .rating-badge.neutral   { background: rgba(139,140,177,0.08); color: var(--text-muted); border: 1px solid rgba(139,140,177,0.18); }
    .rating-ticker { font-size: 0.82rem; font-weight: 800; font-family: monospace; color: var(--accent); }
    .rating-detail { font-size: 0.78rem; color: var(--text-muted); line-height: 1.4; }

    /* ── Catalyst news items ─────────────────────── */
    .news-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1.25rem; }
    .news-item { padding: 0.6rem 0.75rem; border-radius: 8px; background: rgba(255,255,255,0.025); border: 1px solid var(--border); border-left: 3px solid var(--orange); }
    .news-ticker { font-size: 0.72rem; font-weight: 800; font-family: monospace; color: var(--orange); margin-bottom: 0.2rem; }
    .news-text { font-size: 0.78rem; color: #b8b6d4; line-height: 1.45; }

    /* Status */
    .mb-status { text-align: center; padding: 5rem 2rem; color: var(--text-muted); font-size: 0.9rem; }
    .mb-status.error { color: var(--red); }
    .hidden { display: none; }
    .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--accent); border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 10px; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .empty-note { color: var(--text-muted); font-size: 0.82rem; padding: 0.25rem 0; }

    @media (max-width: 900px) {
      .mb-grid3 { grid-template-columns: repeat(2, 1fr); }
      .mb-grid2 { grid-template-columns: 1fr; }
      .news-grid { grid-template-columns: 1fr; }
      .tone-body { grid-template-columns: 1fr; }
      .tone-divider { display: none; }
      .tone-text { margin-bottom: 0.75rem; }
    }
    @media (max-width: 580px) {
      .mb-grid3 { grid-template-columns: 1fr; }
      .mb-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    }
  </style>

  <script>
    function getBadgeType(text) {
      const t = (text || '').toLowerCase();
      if (t.includes('upgrade')) return 'upgrade';
      if (t.includes('downgrade')) return 'downgrade';
      if (t.includes('initiat')) return 'initiated';
      if (t.includes('raised') || t.includes('raises') || t.includes('increases pt')) return 'upgrade';
      if (t.includes('cut') || t.includes('cuts') || t.includes('lowers pt')) return 'downgrade';
      return 'neutral';
    }

    function getBadgeLabel(text) {
      const t = (text || '').toLowerCase();
      if (t.includes('upgrade')) return '↑ Upgrade';
      if (t.includes('downgrade')) return '↓ Downgrade';
      if (t.includes('initiat')) return '● Initiated';
      if (t.includes('raised') || t.includes('raises')) return '↑ PT Raised';
      if (t.includes('cut') || t.includes('cuts')) return '↓ PT Cut';
      if (t.includes('maintained') || t.includes('reiterates')) return '= Maintained';
      return '— Note';
    }

    // Extract ticker from strings like "$AAPL — Firm raises PT..."
    function extractTicker(text) {
      const m = text.match(/^\$([A-Z]+)/);
      return m ? m[0] : '';
    }

    function stripTicker(text) {
      return text.replace(/^\$[A-Z]+\s*[—–-]+\s*/, '').trim();
    }

    // Parse news: "$AAPL — description" → {ticker, text}
    function parseNews(text) {
      const m = text.match(/^(\$[A-Z]+|[A-Z][A-Za-z\s]+?)\s*[—–-]+\s*(.+)$/s);
      if (m) return { ticker: m[1].trim(), text: m[2].trim() };
      return { ticker: '', text: text };
    }

    async function fetchBrief() {
      const content = document.getElementById('brief-content');
      const loading = document.getElementById('loading-state');
      const errorEl = document.getElementById('error-state');

      loading.classList.remove('hidden');
      content.classList.add('hidden');
      errorEl.classList.add('hidden');

      try {
        const response = await fetch('/.netlify/functions/morning-brief');
        const data = await response.json();
        if (data.error) throw new Error(data.error);

        // ── Market Tone ──
        document.getElementById('tone-text').textContent = data.market_tone || '';
        document.getElementById('bias-text').textContent = data.morning_bias || '';

        // ── Econ Calendar ──
        const nonUS = ['ecb','boe','boj','rba','pboc','bank of canada','bank of england','bank of japan','eurozone','germany','german','france','uk cpi','uk gdp','australia','china cpi','japan'];
        const econItems = (data.econ_calendar || []).filter(e =>
          !nonUS.some(kw => (e.event || '').toLowerCase().includes(kw))
        );
        document.getElementById('econ-list').innerHTML = econItems.length > 0
          ? econItems.map(e => `
            <div class="econ-item">
              <div class="econ-impact-dot ${e.impact}"></div>
              <div class="econ-body">
                <div class="econ-name">${e.event}</div>
                <div class="econ-meta">
                  <span class="econ-time">${e.time}</span>
                  ${e.actual ? `<span class="econ-actual">▶ ${e.actual}</span><span class="econ-forecast">est ${e.forecast || '—'}</span>` : (e.forecast ? `<span class="econ-forecast">est ${e.forecast}</span>` : '')}
                </div>
              </div>
            </div>`).join('')
          : '<p class="empty-note">No major US data today.</p>';

        // ── Gaps ──
        const ups = data.gaps?.ups || [];
        const downs = data.gaps?.downs || [];
        let gapsHtml = '';
        if (ups.length > 0) {
          gapsHtml += `<div class="gaps-label up">▲ BEATS / GAP UPS</div>`;
          gapsHtml += ups.map(g => typeof g === 'object'
            ? `<div class="gap-item up"><div class="gap-left"><span class="gap-ticker">${g.ticker}</span><div class="gap-desc">${g.reason || ''}</div></div><span class="gap-move">${g.move || '↑'}</span></div>`
            : `<div class="gap-item up"><span class="gap-ticker">${g}</span><span class="gap-move">↑</span></div>`
          ).join('');
        }
        if (downs.length > 0) {
          gapsHtml += `<div class="gaps-label down">▼ MISSES / GAP DOWNS</div>`;
          gapsHtml += downs.map(g => typeof g === 'object'
            ? `<div class="gap-item down"><div class="gap-left"><span class="gap-ticker">${g.ticker}</span><div class="gap-desc">${g.reason || ''}</div></div><span class="gap-move">${g.move || '↓'}</span></div>`
            : `<div class="gap-item down"><span class="gap-ticker">${g}</span><span class="gap-move">↓</span></div>`
          ).join('');
        }
        document.getElementById('gaps-container').innerHTML = gapsHtml || '<p class="empty-note">No notable pre-market gaps today.</p>';

        // ── Trump Schedule ──
        const schedule = data.trump_schedule || [];
        document.getElementById('trump-list').innerHTML = schedule.length > 0
          ? schedule.map(s => `
            <div class="trump-item">
              <span class="trump-time">${s.time}</span>
              <span class="trump-event">${s.event}</span>
            </div>`).join('')
          : '<p class="empty-note">No scheduled public events.</p>';

        // ── Analyst Ratings ──
        const ratings = data.analyst_actions || [];
        document.getElementById('ratings-list').innerHTML = ratings.length > 0
          ? ratings.map(n => {
              const ticker = extractTicker(n);
              const detail = ticker ? stripTicker(n) : n;
              return `<div class="rating-item">
                <div class="rating-top">
                  <span class="rating-badge ${getBadgeType(n)}">${getBadgeLabel(n)}</span>
                  ${ticker ? `<span class="rating-ticker">${ticker}</span>` : ''}
                </div>
                <div class="rating-detail">${detail}</div>
              </div>`;
            }).join('')
          : '<p class="empty-note">No analyst actions today.</p>';

        // ── Catalyst News ──
        const news = data.breaking_news || [];
        document.getElementById('news-list').innerHTML = news.length > 0
          ? news.map(n => {
              const { ticker, text } = parseNews(n);
              return `<div class="news-item">
                ${ticker ? `<div class="news-ticker">${ticker}</div>` : ''}
                <div class="news-text">${text}</div>
              </div>`;
            }).join('')
          : '<p class="empty-note">No major catalyst news.</p>';

        loading.classList.add('hidden');
        content.classList.remove('hidden');
      } catch (err) {
        loading.classList.add('hidden');
        errorEl.textContent = `Error loading brief: ${err.message}`;
        errorEl.classList.remove('hidden');
      }
    }

    document.getElementById('mb-date').textContent = new Date().toLocaleDateString('en-US', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
    document.getElementById('refresh-btn').addEventListener('click', fetchBrief);
    fetchBrief();
  </script>
</Layout>