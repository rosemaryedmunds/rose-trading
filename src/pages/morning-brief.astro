---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Morning Brief | Rose Trading">
  <main class="mb-wrap">

    <div id="loading-state" class="mb-status">
      <span class="spinner"></span> Scanning markets &amp; schedule...
    </div>
    <div id="error-state" class="mb-status err hidden"></div>

    <div id="brief-content" class="hidden">

      <!-- HEADER -->
      <div class="brief-header">
        <div>
          <h1 class="brief-title">Morning Brief</h1>
          <p id="mb-date" class="brief-date"></p>
        </div>
        <div class="brief-header-right">
          <span class="ai-badge">AI-generated · Gemini 2.5</span>
          <button id="refresh-btn" class="refresh-btn">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- MARKET TONE -->
      <div class="section-block" id="block-tone">
        <div class="section-label">
          <span class="dot dot-blue"></span>
          <span>MARKET TONE</span>
          <span class="gen-time" id="gen-time"></span>
        </div>
        <div class="tone-grid">
          <div class="tone-pane" id="tone-text"></div>
          <div class="tone-pane tone-pane-bias" id="bias-text"></div>
        </div>
      </div>

      <!-- ECON CALENDAR -->
      <div class="section-block" id="block-econ">
        <div class="section-label">
          <span class="dot dot-amber"></span>
          <span>ECONOMIC CALENDAR</span>
        </div>
        <div id="econ-list"></div>
      </div>

      <!-- EARNINGS GAPS -->
      <div class="section-block" id="block-gaps">
        <div class="section-label">
          <span class="dot dot-teal"></span>
          <span>EARNINGS TODAY</span>
        </div>
        <div id="gaps-container"></div>
      </div>

      <!-- ANALYST ACTIONS -->
      <div class="section-block" id="block-ratings">
        <div class="section-label">
          <span class="dot dot-purple"></span>
          <span>ANALYST ACTIONS</span>
        </div>
        <div id="ratings-list"></div>
      </div>

      <!-- TRUMP SCHEDULE -->
      <div class="section-block" id="block-trump">
        <div class="section-label">
          <span class="dot dot-red"></span>
          <span>TRUMP SCHEDULE</span>
        </div>
        <div id="trump-list"></div>
      </div>

      <!-- CATALYST NEWS -->
      <div class="section-block" id="block-news">
        <div class="section-label">
          <span class="dot dot-green"></span>
          <span>CATALYST NEWS</span>
        </div>
        <div id="news-list"></div>
      </div>

      <p class="footer-note">AI-generated · Not financial advice · rose.trading</p>

    </div>
  </main>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .mb-wrap {
      max-width: 800px;
      margin: 0 auto;
      padding: 1.5rem 1rem 4rem;
      font-family: 'SF Mono', 'JetBrains Mono', 'Fira Mono', monospace;
      color: #d4d4d8;
      font-size: 13px;
    }

    /* ── Header ── */
    .brief-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .brief-title { font-family: system-ui, sans-serif; font-size: 1.5rem; font-weight: 800; color: #a78bfa; letter-spacing: -0.02em; }
    .brief-date { font-size: 0.72rem; color: #52525b; margin-top: 0.2rem; }
    .brief-header-right { display: flex; align-items: center; gap: 0.6rem; flex-shrink: 0; }
    .ai-badge { font-size: 0.65rem; color: #52525b; border: 1px solid #27272a; padding: 0.2rem 0.5rem; border-radius: 4px; }
    .refresh-btn { background: #a78bfa; border: none; color: #0f0f11; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; font-weight: 700; font-size: 0.72rem; display: flex; align-items: center; gap: 0.35rem; font-family: inherit; }
    .refresh-btn:hover { opacity: 0.85; }

    /* ── Section blocks ── */
    .section-block {
      border: 1px solid #27272a;
      border-radius: 10px;
      margin-bottom: 0.75rem;
      overflow: hidden;
      background: #111113;
    }

    .section-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 0.85rem;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #52525b;
      border-bottom: 1px solid #1e1e21;
    }

    .gen-time { margin-left: auto; font-size: 0.6rem; color: #3f3f46; }

    /* ── Dots ── */
    .dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .dot-blue   { background: #3b82f6; }
    .dot-amber  { background: #f59e0b; }
    .dot-teal   { background: #14b8a6; }
    .dot-purple { background: #a78bfa; }
    .dot-red    { background: #f87171; }
    .dot-green  { background: #4ade80; }

    /* ── Tone ── */
    .tone-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .tone-pane { padding: 0.85rem 1rem; font-size: 0.8rem; line-height: 1.7; color: #a1a1aa; font-family: system-ui, sans-serif; }
    .tone-pane-bias { border-left: 1px solid #1e1e21; color: #71717a; }

    /* ── Econ ── */
    .econ-row { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 0.85rem; border-bottom: 1px solid #1a1a1d; }
    .econ-row:last-child { border-bottom: none; }
    .econ-impact { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; padding: 0.15rem 0.35rem; border-radius: 3px; flex-shrink: 0; margin-top: 0.1rem; font-family: inherit; }
    .econ-impact.HIGH { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.25); }
    .econ-impact.MED  { background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.25); }
    .econ-impact.LOW  { background: rgba(82,82,91,0.2); color: #71717a; border: 1px solid rgba(82,82,91,0.3); }
    .econ-body { flex: 1; }
    .econ-name { color: #d4d4d8; font-size: 0.8rem; line-height: 1.35; font-family: system-ui, sans-serif; }
    .econ-meta { display: flex; gap: 0.75rem; margin-top: 0.2rem; flex-wrap: wrap; }
    .econ-time { color: #3f3f46; font-size: 0.7rem; }
    .econ-actual { color: #4ade80; font-size: 0.7rem; font-weight: 700; }
    .econ-est { color: #52525b; font-size: 0.7rem; }

    /* ── Gaps ── */
    .gaps-sublabel { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; padding: 0.45rem 0.85rem; color: #3f3f46; border-bottom: 1px solid #1a1a1d; background: #0d0d0f; }
    .gaps-sublabel.up { color: #4ade80; }
    .gaps-sublabel.dn { color: #f87171; }

    .gap-row { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 0.85rem; border-bottom: 1px solid #1a1a1d; }
    .gap-row:last-child { border-bottom: none; }
    .gap-chip { font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.4rem; border-radius: 4px; flex-shrink: 0; font-family: inherit; min-width: 40px; text-align: center; }
    .gap-chip.up { background: rgba(74,222,128,0.12); color: #4ade80; border: 1px solid rgba(74,222,128,0.25); }
    .gap-chip.dn { background: rgba(248,113,113,0.12); color: #f87171; border: 1px solid rgba(248,113,113,0.25); }
    .gap-body { flex: 1; }
    .gap-ticker { font-size: 0.82rem; font-weight: 700; font-family: inherit; }
    .gap-chip.up ~ .gap-body .gap-ticker { color: #4ade80; }
    .gap-chip.dn ~ .gap-body .gap-ticker { color: #f87171; }
    .gap-reason { font-size: 0.73rem; color: #52525b; margin-top: 0.15rem; font-family: system-ui, sans-serif; line-height: 1.4; }
    .gap-move { font-size: 0.78rem; font-weight: 700; white-space: nowrap; margin-left: auto; padding-top: 0.05rem; }

    /* ── Analyst ratings ── */
    .rating-row { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 0.85rem; border-bottom: 1px solid #1a1a1d; }
    .rating-row:last-child { border-bottom: none; }
    .rbadge { font-size: 0.6rem; font-weight: 700; padding: 0.15rem 0.4rem; border-radius: 3px; flex-shrink: 0; margin-top: 0.1rem; letter-spacing: 0.05em; font-family: inherit; }
    .rbadge.upgrade   { background: rgba(74,222,128,0.12);  color: #4ade80;  border: 1px solid rgba(74,222,128,0.25); }
    .rbadge.downgrade { background: rgba(248,113,113,0.12); color: #f87171;  border: 1px solid rgba(248,113,113,0.25); }
    .rbadge.initiated { background: rgba(167,139,250,0.12); color: #a78bfa;  border: 1px solid rgba(167,139,250,0.25); }
    .rbadge.neutral   { background: rgba(82,82,91,0.15);    color: #71717a;  border: 1px solid rgba(82,82,91,0.3); }
    .rating-body { flex: 1; }
    .rticker { font-size: 0.82rem; font-weight: 700; color: #a78bfa; }
    .rdetail { font-size: 0.73rem; color: #52525b; margin-top: 0.15rem; font-family: system-ui, sans-serif; line-height: 1.4; }

    /* ── Trump schedule ── */
    .trump-row { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 0.85rem; border-bottom: 1px solid #1a1a1d; }
    .trump-row:last-child { border-bottom: none; }
    .trump-time-chip { font-size: 0.65rem; font-weight: 700; color: #a78bfa; background: rgba(167,139,250,0.1); border: 1px solid rgba(167,139,250,0.2); padding: 0.2rem 0.45rem; border-radius: 4px; white-space: nowrap; flex-shrink: 0; margin-top: 0.05rem; font-family: inherit; }
    .trump-event { font-size: 0.8rem; color: #a1a1aa; font-family: system-ui, sans-serif; line-height: 1.45; }

    /* ── Catalyst news ── */
    .news-card { padding: 0.75rem 0.85rem; border-bottom: 1px solid #1a1a1d; border-left: 3px solid #f97316; }
    .news-card:last-child { border-bottom: none; }
    .news-top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem; }
    .news-chip { font-size: 0.62rem; font-weight: 700; background: rgba(249,115,22,0.12); color: #f97316; border: 1px solid rgba(249,115,22,0.25); padding: 0.12rem 0.4rem; border-radius: 3px; font-family: inherit; }
    .news-body { font-size: 0.79rem; color: #71717a; font-family: system-ui, sans-serif; line-height: 1.55; }

    /* ── Empty / status ── */
    .empty-row { padding: 0.75rem 0.85rem; color: #3f3f46; font-size: 0.75rem; font-family: system-ui, sans-serif; }
    .mb-status { text-align: center; padding: 5rem 2rem; color: #3f3f46; font-size: 0.85rem; }
    .mb-status.err { color: #f87171; }
    .hidden { display: none; }
    .spinner { display: inline-block; width: 12px; height: 12px; border: 2px solid #a78bfa; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 8px; vertical-align: middle; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .footer-note { text-align: center; font-size: 0.65rem; color: #27272a; margin-top: 2rem; }

    @media (max-width: 560px) {
      .tone-grid { grid-template-columns: 1fr; }
      .tone-pane-bias { border-left: none; border-top: 1px solid #1e1e21; }
      .brief-header { flex-direction: column; gap: 0.75rem; }
    }
  </style>

  <script>
    function getBadgeType(t) {
      t = (t||'').toLowerCase();
      if (t.includes('upgrade')) return 'upgrade';
      if (t.includes('downgrade')) return 'downgrade';
      if (t.includes('initiat')) return 'initiated';
      if (t.includes('raised')||t.includes('raises')||t.includes('increases')) return 'upgrade';
      if (t.includes('cut')||t.includes('cuts')||t.includes('lowers')) return 'downgrade';
      return 'neutral';
    }
    function getBadgeLabel(t) {
      t = (t||'').toLowerCase();
      if (t.includes('upgrade')) return '↑ UPGRADE';
      if (t.includes('downgrade')) return '↓ DOWNGRADE';
      if (t.includes('initiat')) return '● INITIATED';
      if (t.includes('raised')||t.includes('raises')) return '↑ PT RAISED';
      if (t.includes('cut')||t.includes('cuts')) return '↓ PT CUT';
      if (t.includes('maintained')||t.includes('reiterates')) return '= MAINTAINED';
      return '— NOTE';
    }
    function extractTicker(s) {
      const m = s.match(/^\$([A-Z]{1,6})/);
      return m ? m[0] : '';
    }
    function stripTicker(s) {
      return s.replace(/^\$[A-Z]{1,6}\s*[—–\-]+\s*/, '').trim();
    }
    function parseNews(s) {
      const m = s.match(/^(\$[A-Z]{1,6}|[A-Z][A-Za-z &\.]+?)\s*[—–\-]+\s*(.+)$/s);
      return m ? { chip: m[1].trim(), body: m[2].trim() } : { chip: '', body: s };
    }

    async function fetchBrief() {
      const content = document.getElementById('brief-content');
      const loading = document.getElementById('loading-state');
      const errorEl = document.getElementById('error-state');
      loading.classList.remove('hidden');
      content.classList.add('hidden');
      errorEl.classList.add('hidden');

      try {
        const res = await fetch('/.netlify/functions/morning-brief');
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        // Gen time
        const now = new Date();
        document.getElementById('gen-time').textContent =
          'Generated ' + now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });

        // Tone
        document.getElementById('tone-text').textContent = data.market_tone || '';
        document.getElementById('bias-text').textContent = data.morning_bias || '';

        // Econ
        const nonUS = ['ecb','boe','boj','rba','pboc','bank of canada','bank of england','bank of japan','eurozone','germany','german','france','uk ','china cpi','japan','australia'];
        const econ = (data.econ_calendar||[]).filter(e => !nonUS.some(k=>(e.event||'').toLowerCase().includes(k)));
        document.getElementById('econ-list').innerHTML = econ.length
          ? econ.map(e=>`
            <div class="econ-row">
              <span class="econ-impact ${e.impact||'LOW'}">${e.impact||'LOW'}</span>
              <div class="econ-body">
                <div class="econ-name">${e.event}</div>
                <div class="econ-meta">
                  <span class="econ-time">${e.time}</span>
                  ${e.actual?`<span class="econ-actual">▶ ${e.actual}</span>`:''}
                  ${e.forecast?`<span class="econ-est">est ${e.forecast}</span>`:''}
                </div>
              </div>
            </div>`).join('')
          : '<div class="empty-row">No major US economic data today.</div>';

        // Gaps
        const ups = data.gaps?.ups||[];
        const downs = data.gaps?.downs||[];
        let gHtml = '';
        if (ups.length) {
          gHtml += `<div class="gaps-sublabel up">▲ BEATS / GAP UPS</div>`;
          gHtml += ups.map(g => typeof g === 'object'
            ? `<div class="gap-row">
                <span class="gap-chip up">${g.move||'↑'}</span>
                <div class="gap-body">
                  <div class="gap-ticker" style="color:#4ade80">${g.ticker}</div>
                  <div class="gap-reason">${g.reason||''}</div>
                </div>
               </div>`
            : `<div class="gap-row"><span class="gap-chip up">↑</span><div class="gap-body"><div class="gap-ticker" style="color:#4ade80">${g}</div></div></div>`
          ).join('');
        }
        if (downs.length) {
          gHtml += `<div class="gaps-sublabel dn">▼ MISSES / GAP DOWNS</div>`;
          gHtml += downs.map(g => typeof g === 'object'
            ? `<div class="gap-row">
                <span class="gap-chip dn">${g.move||'↓'}</span>
                <div class="gap-body">
                  <div class="gap-ticker" style="color:#f87171">${g.ticker}</div>
                  <div class="gap-reason">${g.reason||''}</div>
                </div>
               </div>`
            : `<div class="gap-row"><span class="gap-chip dn">↓</span><div class="gap-body"><div class="gap-ticker" style="color:#f87171">${g}</div></div></div>`
          ).join('');
        }
        document.getElementById('gaps-container').innerHTML = gHtml || '<div class="empty-row">No notable pre-market earnings gaps today.</div>';

        // Analyst ratings
        const ratings = data.analyst_actions||[];
        document.getElementById('ratings-list').innerHTML = ratings.length
          ? ratings.map(n => {
              const ticker = extractTicker(n);
              const detail = ticker ? stripTicker(n) : n;
              return `<div class="rating-row">
                <span class="rbadge ${getBadgeType(n)}">${getBadgeLabel(n)}</span>
                <div class="rating-body">
                  ${ticker?`<div class="rticker">${ticker}</div>`:''}
                  <div class="rdetail">${detail}</div>
                </div>
              </div>`;
            }).join('')
          : '<div class="empty-row">No major analyst rating changes today.</div>';

        // Trump
        const sched = data.trump_schedule||[];
        document.getElementById('trump-list').innerHTML = sched.length
          ? sched.map(s=>`
            <div class="trump-row">
              <span class="trump-time-chip">${s.time}</span>
              <span class="trump-event">${s.event}</span>
            </div>`).join('')
          : '<div class="empty-row">No scheduled public events found.</div>';

        // News
        const news = data.breaking_news||[];
        document.getElementById('news-list').innerHTML = news.length
          ? news.map(n => {
              const { chip, body } = parseNews(n);
              return `<div class="news-card">
                ${chip?`<div class="news-top"><span class="news-chip">${chip}</span></div>`:''}
                <div class="news-body">${body}</div>
              </div>`;
            }).join('')
          : '<div class="empty-row">No major catalyst news today.</div>';

        loading.classList.add('hidden');
        content.classList.remove('hidden');
      } catch(err) {
        loading.classList.add('hidden');
        errorEl.textContent = `Error: ${err.message}`;
        errorEl.classList.remove('hidden');
      }
    }

    document.getElementById('mb-date').textContent = new Date().toLocaleDateString('en-US', {
      weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
    });
    document.getElementById('refresh-btn').addEventListener('click', fetchBrief);
    fetchBrief();
  </script>
</Layout>