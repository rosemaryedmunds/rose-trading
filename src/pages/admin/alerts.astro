---
// src/pages/admin/alerts.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin | SPX Broadcaster">
  <main class="admin-container">
    <div class="alert-card">
      <header>
        <h1>SPX Signal Room</h1>
        <p>Direct-to-mobile broadcast for paid members</p>
      </header>

      <form id="alertForm">
        <div class="radio-grid">
          <input type="radio" id="entry" name="action" value="ENTRY" checked>
          <label for="entry">ENTRY</label>
          <input type="radio" id="trim" name="action" value="TRIM">
          <label for="trim">TRIM</label>
          <input type="radio" id="exit" name="action" value="EXIT">
          <label for="exit">EXIT</label>
        </div>

        <div class="row">
          <div class="input-group">
            <label>Ticker</label>
            <input type="text" value="SPX" readonly class="readonly-input">
          </div>
          <div class="input-group">
            <label>Strike/Type</label>
            <input type="text" id="strike" name="strike" placeholder="7100 Call" required>
          </div>
        </div>

        <div class="input-group">
          <label>Expiry</label>
          <input type="date" id="expiry" name="expiry" required>
        </div>

        <div class="input-group">
          <label>Price</label>
          <input type="number" id="price" name="price" step="0.05" placeholder="5.25" required>
        </div>

        <button type="submit" id="sendBtn">SEND PREMIUM NOTIFICATION</button>
      </form>
    </div>
  </main>
</Layout>

<style>
  .admin-container { max-width: 450px; margin: 3rem auto; padding: 1rem; color: #fff; }
  .alert-card { background: #000; padding: 2rem; border-radius: 16px; border: 1px solid #333; }
  header { text-align: center; margin-bottom: 2rem; }
  h1 { font-size: 1.5rem; margin-bottom: 0.25rem; color: #fff; }
  p { font-size: 0.85rem; color: #666; }
  .radio-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 1.5rem; }
  .radio-grid label { background: #111; padding: 12px; text-align: center; border-radius: 8px; cursor: pointer; border: 1px solid #222; font-size: 0.8rem; font-weight: bold; }
  input[type="radio"]:checked + label { background: #e63946; color: #fff; border-color: #e63946; }
  input[type="radio"] { display: none; }
  .input-group { margin-bottom: 1.25rem; display: flex; flex-direction: column; }
  label { margin-bottom: 0.5rem; color: #444; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
  input { background: #111; border: 1px solid #222; color: #fff; padding: 14px; border-radius: 8px; font-size: 1rem; width: 100%; }
  .readonly-input { color: #555; background: #080808; border-color: #111; }
  .row { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; }
  button { background: #fff; color: #000; border: none; padding: 1.2rem; width: 100%; border-radius: 8px; font-weight: 800; font-size: 1rem; cursor: pointer; margin-top: 1rem; transition: 0.2s; }
  button:active { transform: scale(0.98); background: #ccc; }
</style>
<script>
  const form = document.getElementById('alertForm');
  const previewMessage = document.getElementById('previewMessage');
  const previewImage = document.getElementById('previewImage');
  const screenshotInput = document.getElementById('screenshot');

  // 1. Set default date to today
  const dateInput = document.getElementById('expiry');
  dateInput.valueAsDate = new Date();

  // 2. Function to update the Live Preview text
  const updatePreview = () => {
    const formData = new FormData(form);
    
    // Format the date for the notification
    const dateValue = new Date(formData.get('expiry'));
    const formattedDate = dateValue.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

    // Final Message Construction
    const message = `${formData.get('action')}: SPX ${formData.get('strike')} Exp ${formattedDate} at ${formData.get('price')}`;
    previewMessage.innerText = message;
  };

  // 3. Handle Image Preview
  screenshotInput.addEventListener('change', function() {
    const file = this.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        previewImage.src = e.target.result;
        previewImage.classList.remove('hidden');
      }
      reader.readAsDataURL(file);
    } else {
      previewImage.classList.add('hidden');
    }
  });

  // 4. Update preview on input changes
  form.addEventListener('input', updatePreview);

  // 5. Initial update
  updatePreview();

  // 6. Handle Form Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!confirm(`PUSH ALERT:\n"${previewMessage.innerText}"\n\n(Include Screenshot: ${screenshotInput.files[0] ? 'Yes' : 'No'})`)) return;

    // ... code to send to OneSignal API route ...
    alert("Alert Broadcasted! 🚀");
  });
</script>