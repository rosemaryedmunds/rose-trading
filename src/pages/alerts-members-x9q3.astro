---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Members Alerts | Rose.Trading">

<Fragment slot="head">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
</Fragment>

  <div id="auth-checking" class="auth-screen">
    <div class="auth-spinner"></div>
    <p>Verifying your membership...</p>
  </div>

  <div id="auth-failed" class="auth-screen" style="display:none;">
    <div class="auth-icon"><Icon name="lucide:lock" /></div>
    <h2>Access Required</h2>
    <p>You need an active Rose.Trading subscription to view this page.</p>
    <a href="https://whop.com/checkout/plan_HE6PHzR97QEX3" class="auth-btn">Subscribe for $39.99/mo →</a>
    <a href="/.netlify/functions/whop-login" class="auth-link">Already subscribed? Sign in</a>
  </div>

  <section class="alerts-page" id="main-content" style="display:none;">
    <div class="page-header">
      <h1 style="font-family:Syne,sans-serif;font-weight:800;font-size:3rem;background:linear-gradient(135deg,#998BFF,#5F5CFF);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;color:transparent;margin-bottom:0.75rem;">Trade Alerts</h1>
      <p class="disclaimer">I am not a financial advisor. Nothing shared in this community is financial advice. All content is for educational purposes only. Never trade with money you cannot afford to lose. Past performance does not guarantee future results. You are 100% responsible for your own trading decisions.</p>
      <div class="alert-cta">
        <button id="enable-alerts-btn" class="enable-btn" onclick="enableNotifications()">
          <Icon name="lucide:bell" />
          Enable Trade Alerts
        </button>
        <p class="notif-hint" id="notif-hint"></p>
      </div>
      <div class="pwa-card">
        <div class="pwa-card-header">
          <Icon name="lucide:smartphone" />
          <span>Get Alerts on Your iPhone</span>
        </div>
        <ol class="pwa-steps">
          <li><span class="step-num">1</span><span>Open <strong>rose.trading</strong> in Safari</span></li>
          <li><span class="step-num">2</span><span>Tap the <strong>Share</strong> button at the bottom of Safari</span></li>
          <li><span class="step-num">3</span><span>Scroll down and tap <strong>"Add to Home Screen"</strong></span></li>
          <li><span class="step-num">4</span><span>Tap <strong>Add</strong> in the top right corner</span></li>
          <li><span class="step-num">5</span><span>Open the app from your Home Screen and tap <strong>Enable Trade Alerts</strong></span></li>
        </ol>
      </div>
    </div>

    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="alert">Alerts</button>
      <button class="filter-btn" data-filter="review">Reviews</button>
    </div>

    <div class="feed" id="feed">
      <div class="feed-skeleton">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
      </div>
    </div>

    <div class="empty-state" id="empty-state" style="display:none;">
      <Icon name="lucide:radio-tower" />
      <p>No alerts yet today. Check back during market hours (9:30 AM – 4:00 PM CT).</p>
    </div>

    <p class="refresh-note">Feed auto-refreshes every 60 seconds</p>

    <!-- ─── WEEKLY REVIEWS ─── -->
    <div class="yt-section">
      <div class="yt-section-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
        Weekly Reviews
      </div>
      <p class="yt-desc">Catch up on every weekly market review — breakdowns, setups, and lessons from the week.</p>
      <a href="https://www.youtube.com/watch?v=IbgRemAKWdk&list=PL1P32hXnOI60kbueNSZJtXXCi3LK5r_6e" target="_blank" rel="noopener" class="yt-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-2.75C14.78 1.5 12 1.5 12 1.5s-2.78 0-3.82 2.44A4.83 4.83 0 0 1 4.41 6.69C2 7.73 2 10 2 12s0 4.27 2.41 5.31a4.83 4.83 0 0 1 3.77 2.75C9.22 22.5 12 22.5 12 22.5s2.78 0 3.82-2.44a4.83 4.83 0 0 1 3.77-2.75C22 16.27 22 14 22 12s0-4.27-2.41-5.31zM10 15.5v-7l6 3.5-6 3.5z"/></svg>
        Watch on YouTube
      </a>
    </div>

    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="alert">Alerts</button>
      <button class="filter-btn" data-filter="review">Reviews</button>
    </div>

    <div class="feed" id="feed">
      <div class="feed-skeleton">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
      </div>
    </div>

    <div class="empty-state" id="empty-state" style="display:none;">
      <Icon name="lucide:radio-tower" />
      <p>No alerts yet today. Check back during market hours (9:30 AM – 4:00 PM CT).</p>
    </div>

    <p class="refresh-note">Feed auto-refreshes every 60 seconds</p>

  </section>

</Layout>

<script is:inline>
  let allItems  = [];
  let curFilter = 'all';

  function resolveChartUrl(url) {
    if (!url) return null;
    const tvMatch = url.match(/tradingview\.com\/x\/([A-Za-z0-9]+)\/?$/);
    if (tvMatch) {
      const id = tvMatch[1];
      const prefix = id.charAt(0).toLowerCase();
      return `https://s3.tradingview.com/snapshots/${prefix}/${id}.png`;
    }
    return url;
  }

  async function checkAuth() {
    try {
      const res  = await fetch('/.netlify/functions/verify-session');
      const data = await res.json();
      document.getElementById('auth-checking').style.display = 'none';
      if (data.valid) {
        document.getElementById('main-content').style.display = 'block';
        loadFeed();
        setInterval(loadFeed, 60000);
      } else {
        if (data.reason === 'no_membership') {
          document.getElementById('auth-failed').style.display = 'flex';
        } else {
          window.location.href = '/.netlify/functions/whop-login';
        }
      }
    } catch {
      document.getElementById('auth-checking').style.display = 'none';
      document.getElementById('auth-failed').style.display = 'flex';
    }
  }

  async function loadFeed() {
    try {
      const res = await fetch('/feed.json?t=' + Date.now());
      allItems  = res.ok ? await res.json() : [];
    } catch { allItems = []; }
    renderFeed();
  }

  function renderFeed() {
    const feed  = document.getElementById('feed');
    const empty = document.getElementById('empty-state');
    const items = curFilter === 'all' ? allItems : allItems.filter(i => i.type === curFilter);

    if (!items.length) {
      feed.innerHTML = '';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';

    feed.innerHTML = items.map(item => {
      const isAlert  = item.type === 'alert';
      const chartSrc = resolveChartUrl(item.chartUrl);
      const time = new Date(item.timestamp).toLocaleString('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short', month: 'short', day: 'numeric',
        hour: '2-digit', minute: '2-digit'
      }) + ' CT';

      const chartHtml = chartSrc
        ? `<a href="${chartSrc}" target="_blank" rel="noopener"
             style="display:block;margin-top:0.75rem;border-radius:8px;overflow:hidden;border:1px solid rgba(153,139,255,0.2);line-height:0;">
             <img src="${chartSrc}" alt="Chart" loading="lazy"
               style="display:block;width:100%;height:240px;object-fit:cover;object-position:top center;max-width:100%;">
           </a>`
        : '';

      if (isAlert) {
        const isCall   = item.message.includes('CALL');
        const isPut    = item.message.includes('PUT');
        const isSwing  = item.reviewType === 'SWING';
        const accent   = isCall ? '#3DDC84' : isPut ? '#FF5C5C' : '#998BFF';
        const tagLabel = isSwing
          ? ('SWING' + (item.ticker ? ' · ' + item.ticker : ''))
          : 'ALERT';
        return `
          <div style="background:#1C1E2D;border:1px solid rgba(153,139,255,0.15);border-left:4px solid ${accent};border-radius:14px;padding:1.25rem 1.5rem;overflow:hidden;box-sizing:border-box;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
              <span style="font-size:0.65rem;letter-spacing:0.15em;font-family:'JetBrains Mono',monospace;font-weight:700;padding:0.25rem 0.65rem;border-radius:6px;color:${accent};background:${accent}22;border:1px solid ${accent}44;">${tagLabel}</span>
              <span style="font-size:0.7rem;color:#555;font-family:'JetBrains Mono',monospace;">${time}</span>
            </div>
            <div style="font-family:Syne,sans-serif;font-size:1.05rem;font-weight:700;color:#E0E0E0;line-height:1.5;">${item.message}</div>
            ${chartHtml}
          </div>`;
      }

      const reviewType = item.reviewType || 'NOTE';
      const label = reviewType === 'PRE-MARKET'  ? 'PRE-MARKET'  :
                    reviewType === 'POST-MARKET' ? 'POST-MARKET' : reviewType;
      return `
        <div style="background:#1C1E2D;border:1px solid rgba(153,139,255,0.15);border-left:4px solid #998BFF;border-radius:14px;padding:1.25rem 1.5rem;overflow:hidden;box-sizing:border-box;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;">
            <span style="font-size:0.65rem;letter-spacing:0.15em;font-family:'JetBrains Mono',monospace;font-weight:700;padding:0.25rem 0.65rem;border-radius:6px;color:#998BFF;background:rgba(153,139,255,0.1);border:1px solid rgba(153,139,255,0.25);">${label}</span>
            <span style="font-size:0.7rem;color:#555;font-family:'JetBrains Mono',monospace;">${time}</span>
          </div>
          <div style="font-size:0.92rem;color:#b0b0c0;line-height:1.75;white-space:pre-wrap;">${item.message}</div>
          ${chartHtml}
        </div>`;
    }).join('');
  }

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      curFilter = btn.dataset.filter;
      renderFeed();
    });
  });

  function enableNotifications() {
    const hint  = document.getElementById('notif-hint');
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
    const isPWA = window.navigator.standalone === true;
    if (isIOS && !isPWA) {
      hint.textContent = 'Follow the install steps below to enable alerts on iPhone.';
      hint.style.color = '#998BFF';
      document.querySelector('.pwa-card').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    if (window.OneSignal?.Slidedown) {
      window.OneSignal.Slidedown.promptPush()
        .then(() => {
          hint.textContent = 'Subscribed! Alerts will come straight to your phone.';
          hint.style.color = '#3DDC84';
          if (window.OneSignal.User) {
            window.OneSignal.User.addTag('subscriber', 'true');
          }
        })
        .catch(() => {
          hint.textContent = 'Notifications may be blocked. Check your browser settings.';
          hint.style.color = '#FF5C5C';
        });
    } else {
      hint.textContent = 'Still loading... please wait a moment and try again.';
    }
  }

  checkAuth();
</script>

<style>
  :root {
    --bg:      #0B0C15;
    --surface: #1C1E2D;
    --border:  rgba(153,139,255,0.15);
    --purple:  #998BFF;
    --blue:    #5F5CFF;
    --green:   #3DDC84;
    --red:     #FF5C5C;
    --text:    #E0E0E0;
    --muted:   #555;
  }

  :global(body) { background: var(--bg); color: var(--text); }

  .auth-screen {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; min-height: 60vh; text-align: center;
    gap: 1rem; padding: 2rem; color: var(--muted);
  }
  .disclaimer {
    font-size: 0.78rem; color: var(--muted); max-width: 560px;
    margin: 0 auto 1.5rem; line-height: 1.6; text-align: center;
    padding: 0.75rem 1rem; border: 1px solid var(--border);
    border-radius: 8px; background: rgba(255,255,255,0.02);
  }
  .auth-spinner {
    width: 36px; height: 36px; border: 3px solid var(--border);
    border-top-color: var(--purple); border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .auth-icon [data-icon] { width: 3rem; height: 3rem; stroke: var(--purple); }
  .auth-screen h2 { color: var(--text); font-family: 'Syne', sans-serif; font-size: 1.5rem; }
  .auth-screen p  { color: var(--muted); font-size: 0.95rem; max-width: 340px; }
  .auth-btn {
    background: var(--blue); color: #fff; text-decoration: none;
    padding: 0.75rem 1.75rem; border-radius: 10px; font-weight: 700;
    font-size: 0.95rem; font-family: 'Syne', sans-serif;
  }
  .auth-link { color: var(--purple); font-size: 0.82rem; text-decoration: none; }
  .auth-link:hover { text-decoration: underline; }

  .alerts-page { max-width: 760px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  .page-header  { text-align: center; margin-bottom: 2.5rem; }

  .alert-cta { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-bottom: 1.5rem; }
  .enable-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: #5F5CFF; color: #fff; border: none;
    padding: 0.85rem 1.75rem; border-radius: 8px;
    font-family: 'Syne', sans-serif;
    font-size: 1rem; font-weight: 700; cursor: pointer;
    box-shadow: 0 4px 20px rgba(95,92,255,0.35);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .enable-btn [data-icon] { width: 18px; height: 18px; stroke: #fff; }
  .enable-btn:hover  { box-shadow: 0 6px 24px rgba(95,92,255,0.5); transform: translateY(-1px); }
  .enable-btn:active { transform: scale(0.97); }
  .notif-hint { font-size: 0.82rem; min-height: 1.2em; margin: 0; }

  .pwa-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; padding: 1.5rem;
    text-align: left; max-width: 500px; margin: 0 auto;
  }
  .pwa-card-header {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: 'Syne', sans-serif;
    font-size: 0.95rem; font-weight: 700; color: var(--purple);
    margin-bottom: 1.25rem; padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .pwa-card-header [data-icon] { width: 18px; height: 18px; stroke: var(--purple); }
  .pwa-steps { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .pwa-steps li { display: flex; align-items: flex-start; gap: 0.85rem; font-size: 0.88rem; color: var(--text); line-height: 1.5; }
  .step-num {
    display: flex; align-items: center; justify-content: center;
    min-width: 24px; height: 24px;
    background: rgba(95,92,255,0.15); border: 1px solid rgba(95,92,255,0.3);
    color: var(--blue); border-radius: 50%;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem; font-weight: 700;
  }
  .pwa-steps strong { color: var(--purple); }

  .filter-bar {
    display: flex; gap: 0.5rem; margin-bottom: 2rem;
    border-bottom: 1px solid var(--border); padding-bottom: 1rem;
  }
  .filter-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    background: transparent; border: 1px solid var(--border); color: var(--muted);
    padding: 0.4rem 1rem; border-radius: 100px; font-size: 0.8rem;
    cursor: pointer; transition: all 0.15s; font-family: inherit;
  }
  .filter-btn:hover  { border-color: var(--purple); color: var(--purple); }
  .filter-btn.active { background: var(--blue); border-color: var(--blue); color: #fff; }

  .feed { display: flex; flex-direction: column; gap: 1rem; }

  .feed-skeleton { display: flex; flex-direction: column; gap: 1rem; }
  .skeleton-card {
    height: 100px; border-radius: 14px; border: 1px solid var(--border);
    background: linear-gradient(90deg, var(--surface) 25%, #22243a 50%, var(--surface) 75%);
    background-size: 200% 100%; animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

  .empty-state { text-align: center; padding: 4rem 1rem; color: var(--muted); }
  .empty-state [data-icon] { width: 3rem; height: 3rem; stroke: var(--muted); margin-bottom: 1rem; }
  .empty-state p { margin-top: 0.5rem; }

  .refresh-note {
    text-align: center; font-size: 0.72rem; color: var(--muted);
    margin-top: 2rem; font-family: 'JetBrains Mono', monospace;
  }

  /* ── Weekly Reviews ───────────────────────────────────────────── */
  .section-divider {
    height: 1px; background: var(--border);
    margin: 3rem 0 2.5rem;
  }
  .weekly-reviews { margin-bottom: 2rem; }
  .section-header {
    display: flex; align-items: center; gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .section-header [data-icon] { width: 1.4rem; height: 1.4rem; stroke: var(--purple); }
  .section-header h2 {
    font-family: 'Syne', sans-serif; font-size: 1.5rem;
    font-weight: 800; color: var(--text); margin: 0;
  }
  .section-sub {
    font-size: 0.85rem; color: var(--muted);
    margin: 0 0 1.25rem;
  }
  .playlist-wrap {
    position: relative; width: 100%; padding-bottom: 56.25%;
    border-radius: 12px; overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .playlist-wrap iframe {
    position: absolute; inset: 0;
    width: 100%; height: 100%; border: none;
  }
  .playlist-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: 1rem; font-size: 0.82rem;
    color: var(--purple); text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
  }
  .playlist-link [data-icon] { width: 13px; height: 13px; stroke: var(--purple); }
  .playlist-link:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .alerts-page { padding: 2rem 1rem 4rem; }
    .pwa-card { padding: 1rem; }
  }
</style>
